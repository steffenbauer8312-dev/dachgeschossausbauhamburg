---
import BaseHead from '@/components/layout/BaseHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import StickyCtaBar from '@/components/layout/StickyCtaBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  currentPath?: string;
}
const { title, description, ogImage, canonical, currentPath = '/', noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="de">
<head>
  <BaseHead {title} {description} {ogImage} {canonical} {noindex} />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-C3W72LFPSK"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-C3W72LFPSK');
  </script>
</head>
<body class="flex flex-col min-h-screen">
  <Header currentPath={currentPath} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <StickyCtaBar />
</body>
</html>