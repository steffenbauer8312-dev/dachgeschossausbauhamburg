---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---

<a href="/" class="flex items-center gap-3" aria-label="dachgeschossausbaumuenchen.de – Zur Startseite">
  <!-- Logo Icon -->
  <svg class="w-9 h-9 lg:w-10 lg:h-10 flex-shrink-0" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Roof -->
    <path d="M20 6L4 20H10L20 10L30 20H36L20 6Z" fill="var(--primary, #2D4A3E)"/>
    <!-- Attic window (rounded square) -->
    <rect x="16" y="22" width="8" height="6" rx="1.5" fill="var(--secondary, #C9A96E)"/>
    <!-- Window cross -->
    <line x1="20" y1="22" x2="20" y2="28" stroke="var(--primary, #2D4A3E)" stroke-width="0.75" stroke-linecap="round"/>
    <line x1="16" y1="25" x2="24" y2="25" stroke="var(--primary, #2D4A3E)" stroke-width="0.75" stroke-linecap="round"/>
    <!-- Building body -->
    <rect x="12" y="28" width="16" height="8" rx="1" fill="var(--primary, #2D4A3E)" opacity="0.85"/>
  </svg>

  <!-- Logo Text -->
  <div class="flex items-baseline gap-1">
    <span class="text-base lg:text-lg font-bold text-primary leading-none">Dachgeschoss</span>
    <span class="text-base lg:text-lg font-light text-secondary leading-none">ausbau</span>
    <span class="hidden xl:inline text-xs font-medium text-text-secondary leading-none ml-1">München</span>
  </div>
</a>