---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---

<a href="/" class="flex items-center gap-3" aria-label="dachgeschossausbauhamburg.de – Zur Startseite">
  <!-- Logo Image -->
  <img
    src="/logo.webp"
    srcset="/logo-small.png 200w, /logo.png 400w"
    sizes="(max-width: 768px) 36px, 48px"
    width="48"
    height="48"
    alt="Dachgeschossausbau Hamburg Logo"
    class="w-9 lg:w-12 h-auto flex-shrink-0"
    loading="eager"
  />

  <!-- Logo Text -->
  <div class="flex items-baseline gap-1">
    <span class="text-base lg:text-lg font-bold text-primary leading-none">Dachgeschoss</span>
    <span class="text-base lg:text-lg font-light text-secondary leading-none">ausbau</span>
    <span class="hidden xl:inline text-xs font-medium text-text-secondary leading-none ml-1">Hamburg</span>
  </div>
</a>