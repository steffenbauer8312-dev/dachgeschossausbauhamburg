---
import MobileNav from './MobileNav.astro';
import Logo from '@/components/ui/Logo.astro';

const { currentPath = '/' } = Astro.props;
const desktopNav = [
  { label: 'Leistungen', href: '/leistungen' },
  { label: 'Hamburger Bezirke', href: '/standorte/eppendorf' },
  { label: 'Kontakt',    href: '/kontakt' },
];
---
<header class="sticky top-0 z-30 bg-surface/95 backdrop-blur border-b border-border">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 lg:h-20">
    <!-- Logo -->
    <Logo />

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-8">
      {desktopNav.map(item => (
        <a
          href={item.href}
          class={`text-sm font-medium transition-colors ${
            currentPath.startsWith(item.href)
              ? 'text-primary'
              : 'text-text-secondary hover:text-text-primary'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a href="/kontakt" class="cta-primary text-sm px-6 py-3">
        Beratung anfragen
      </a>
    </nav>

    <!-- Mobile Nav -->
    <MobileNav currentPath={currentPath} />
  </div>
</header>