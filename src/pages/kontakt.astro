---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import LeadGenForm from '@/components/forms/LeadGenForm.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import { generateLocalBusinessSchema } from '@/lib/schema';

const pageTitle = 'Kontakt – Dachgeschossausbau Hamburg';
const pageDescription = 'Kostenlose Erstberatung für Ihren Dachgeschossausbau in Hamburg. Kontaktieren Sie uns unverbindlich – wir melden uns innerhalb von 24 Stunden.';

const schema = JSON.stringify(generateLocalBusinessSchema());
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/kontakt/"
  currentPath="/kontakt/"
>
  <JsonLdSchema schema={schema} />

  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-xl mx-auto">
        <SectionHeader
          badge="Kontakt"
          heading="Kostenlose Erstberatung anfragen"
          subheading="Erzählen Sie uns von Ihrem Projekt – wir melden uns innerhalb von 24 Stunden."
        />

        <!-- Leadgen-Formular -->
        <div class="bg-surface rounded-2xl border border-border p-8 mb-12">
          <LeadGenForm />
        </div>

        <!-- Alternativer Kontakt -->
        <div class="text-center space-y-4">
          <div>
            <p class="text-sm font-semibold text-text-primary mb-1">Oder schreiben Sie uns direkt:</p>
            <a href="mailto:info@dachgeschossausbauhamburg.de" class="text-primary hover:underline text-lg">
              info@dachgeschossausbauhamburg.de
            </a>
          </div>

          <div class="border-t border-border pt-8">
            <p class="text-sm text-text-secondary max-w-md mx-auto leading-relaxed">
              <strong class="text-text-primary">Fester Ansprechpartner</strong><br />
              Vom ersten Gespräch bis zur Übergabe: ein Team, eine Nummer, alles
              aus einer Hand. Kein Vermittlungsaufwand – wir setzen selbst um.
            </p>
          </div>

          <div class="bg-bg rounded-xl p-6 mt-6">
            <p class="text-sm font-semibold text-text-primary mb-2">Hamburger Außenbezirke:</p>
            <p class="text-sm text-text-secondary">
              Bergedorf · Harburg · Eilbek · Wandsbek · Rahlstedt · Langenhorn · Hummelsbüttel – und das gesamte Hamburger Stadtgebiet.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>