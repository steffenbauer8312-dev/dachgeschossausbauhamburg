---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import BreadcrumbList from '@/components/seo/BreadcrumbList.astro';
import {
  generateLocalBusinessSchema,
  generateBreadcrumbSchema,
  generateArticleSchema,
  AUTHOR_PRIMARY,
  AUTHOR_ARCHITEKT,
  AUTHOR_STATIKER,
} from '@/lib/schema';
import { NEWS, NEWS_CATEGORIES, type NewsItem } from '@/data/news';

export async function getStaticPaths() {
  return NEWS.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
const currentPath = `/news/${item.slug}/`;

const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'News', href: '/news/' },
  { label: item.title, href: currentPath },
];

const AUTHOR_MAP: Record<string, typeof AUTHOR_PRIMARY> = {
  'Steffen Bauer': AUTHOR_PRIMARY,
  'Anna Reinhardt': AUTHOR_ARCHITEKT,
  'Markus Lehmann': AUTHOR_STATIKER,
};
const articleAuthor = AUTHOR_MAP[item.author] || AUTHOR_PRIMARY;

const articleSchema = JSON.stringify(generateArticleSchema({
  headline: item.title,
  description: item.excerpt,
  author: articleAuthor,
  reviewer: AUTHOR_ARCHITEKT,
  datePublished: item.datePublished,
  dateModified: item.datePublished,
  lastReviewed: '2026-09-16',
  keywords: item.tags,
  url: `https://dachgeschossausbauhamburg.de${currentPath}`,
}));

const categoryInfo = NEWS_CATEGORIES.find((c) => c.id === item.category);
const otherNews = NEWS
  .filter((n) => n.slug !== item.slug && n.category === item.category)
  .slice(0, 3);
---

<BaseLayout
  title={`${item.title} – News Dachgeschossausbau Hamburg`}
  description={item.excerpt}
  canonical={currentPath}
  currentPath={currentPath}
>
  <JsonLdSchema schema={JSON.stringify(generateLocalBusinessSchema())} />
  <JsonLdSchema schema={articleSchema} />
  <JsonLdSchema schema={JSON.stringify(generateBreadcrumbSchema([
    { name: 'Home', url: 'https://dachgeschossausbauhamburg.de/' },
    { name: 'News', url: 'https://dachgeschossausbauhamburg.de/news/' },
    { name: item.title, url: `https://dachgeschossausbauhamburg.de${currentPath}` },
  ]))} />

  <BreadcrumbList items={breadcrumbItems} />

  <!-- Article -->
  <article>
    <!-- Hero -->
    <section class="bg-primary text-white">
      <Container>
        <div class="py-16 lg:py-20 max-w-3xl mx-auto">
          {categoryInfo && (
            <span class={`inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 ${categoryInfo.color}`}>
              {categoryInfo.label}
            </span>
          )}
          <h1 class="text-3xl lg:text-4xl xl:text-5xl font-bold leading-tight mb-6">
            {item.title}
          </h1>
          <div class="flex flex-wrap items-center gap-4 text-sm text-white/70">
            <time datetime={item.datePublished}>
              {new Date(item.datePublished).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span>·</span>
            <span>von {item.author}</span>
          </div>
        </div>
      </Container>
    </section>

    <!-- Content -->
    <section class="py-16 bg-bg">
      <Container>
        <div class="max-w-3xl mx-auto">
          <div class="bg-surface rounded-2xl border border-border p-8 lg:p-10">
            <p class="text-xl leading-relaxed font-medium text-text-primary mb-6">
              {item.excerpt}
            </p>
            <div class="prose-content space-y-4 text-text-secondary leading-relaxed">
              {item.body.split('\n').filter((p) => p.trim()).map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>

            {item.tags && item.tags.length > 0 && (
              <div class="mt-8 pt-6 border-t border-border flex flex-wrap gap-2 text-xs">
                {item.tags.map((tag) => (
                  <span class="bg-bg px-3 py-1 rounded-full text-text-secondary">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- Verwandte News -->
          {otherNews.length > 0 && (
            <div class="mt-12">
              <h2 class="text-xl font-bold text-text-primary mb-4">Weitere {categoryInfo?.label}-News</h2>
              <div class="space-y-3">
                {otherNews.map((n) => (
                  <a
                    href={`/news/${n.slug}/`}
                    class="block bg-surface rounded-xl border border-border hover:border-primary transition-colors p-5"
                  >
                    <time class="text-xs text-text-secondary">
                      {new Date(n.datePublished).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    <h3 class="font-bold text-text-primary mt-1">{n.title}</h3>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- CTA -->
          <div class="mt-12 text-center">
            <a
              href="/news/"
              class="inline-flex items-center gap-2 text-primary font-semibold hover:underline"
            >
              <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
              Zurück zur News-Übersicht
            </a>
          </div>
        </div>
      </Container>
    </section>
  </article>
</BaseLayout>