---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import LeadGenForm from '@/components/forms/LeadGenForm.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import BreadcrumbList from '@/components/seo/BreadcrumbList.astro';
import {
  generateLocalBusinessSchema,
  generateBreadcrumbSchema,
  AUTHOR_PRIMARY,
  AUTHOR_ARCHITEKT,
  generateArticleSchema,
} from '@/lib/schema';

const currentPath = '/standorte/vergleich/';
const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Standorte', href: '/standorte/' },
  { label: 'Stadtteil-Vergleich', href: currentPath },
];

const PAIRS = [
  {
    a: { name: 'Eppendorf', href: '/standorte/eppendorf/', miete: '14–18 €/m²', kauf: '5.000–8.000 €/m²', ehsg: 'Ja (Eimsbüttel-Nord)', dgausbau: '1.800–2.500 €/m²', top: 'Wertsteigerung, hohe Mieten' },
    b: { name: 'Winterhude', href: '/standorte/winterhude/', miete: '13–17 €/m²', kauf: '4.500–7.000 €/m²', ehsg: 'Ja (Hamburg-Nord)', dgausbau: '1.700–2.300 €/m²', top: 'Wachstums-Mikrolage' },
    winner: 'Eppendorf (höhere Mieten), Winterhude (mehr Platz)',
  },
  {
    a: { name: 'Altona', href: '/standorte/altona/', miete: '12–18 €/m²', kauf: '4.500–7.500 €/m²', ehsg: 'Ja (Altstadt + Nord)', dgausbau: '1.800–2.500 €/m²', top: 'Denkmal + Villen' },
    b: { name: 'Eimsbüttel', href: '/standorte/eimsbuettel/', miete: '14–22 €/m²', kauf: '5.500–9.000 €/m²', ehsg: 'Ja (Eimsbüttel-Nord)', dgausbau: '1.800–2.500 €/m²', top: 'Familienfreundlich' },
    winner: 'Eimsbüttel (höhere Mieten), Altona (mehr Baustil-Mix)',
  },
  {
    a: { name: 'Harburg', href: '/standorte/harburg/', miete: '9–13 €/m²', kauf: '2.800–4.500 €/m²', ehsg: 'Nein', dgausbau: '1.200–1.800 €/m²', top: 'Höchste Cashflow-Rendite' },
    b: { name: 'Bergedorf', href: '/standorte/bergedorf/', miete: '10–14 €/m²', kauf: '3.500–5.000 €/m²', ehsg: 'Nein', dgausbau: '1.400–2.000 €/m²', top: 'Wachstum, Natur' },
    winner: 'Bergedorf (höhere Mieten), Harburg (höchste Cashflow-Rendite)',
  },
];

const articleSchema = JSON.stringify(generateArticleSchema({
  headline: 'Hamburger Stadtteile im Vergleich – Eppendorf vs. Winterhude & Co.',
  description: 'Welcher Hamburger Stadtteil passt zu Ihrem DG-Ausbau? Direktvergleich Eppendorf/Winterhude, Altona/Eimsbüttel, Harburg/Bergedorf.',
  author: AUTHOR_PRIMARY,
  reviewer: AUTHOR_ARCHITEKT,
  datePublished: '2026-05-20',
  dateModified: '2026-09-16',
  lastReviewed: '2026-09-16',
  keywords: ['Stadtteil-Vergleich Hamburg', 'DG-Ausbau Stadtteile', 'Eppendorf Winterhude', 'Altona Eimsbüttel'],
  url: `https://dachgeschossausbauhamburg.de${currentPath}`,
}));
---

<BaseLayout
  title="Hamburger Stadtteile im Vergleich – Welcher passt zu Ihnen?"
  description="Welcher Hamburger Stadtteil eignet sich am besten für DG-Ausbau? Direktvergleich Eppendorf vs. Winterhude, Altona vs. Eimsbüttel, Harburg vs. Bergedorf."
  canonical={currentPath}
  currentPath={currentPath}
>
  <JsonLdSchema schema={JSON.stringify(generateLocalBusinessSchema())} />
  <JsonLdSchema schema={articleSchema} />
  <JsonLdSchema schema={JSON.stringify(generateBreadcrumbSchema([
    { name: 'Home', url: 'https://dachgeschossausbauhamburg.de/' },
    { name: 'Standorte', url: 'https://dachgeschossausbauhamburg.de/standorte/' },
    { name: 'Vergleich', url: `https://dachgeschossausbauhamburg.de${currentPath}` },
  ]))} />

  <BreadcrumbList items={breadcrumbItems} />

  <section class="bg-primary text-white">
    <Container>
      <div class="py-20 lg:py-24 text-center max-w-3xl mx-auto">
        <span class="inline-block text-sm font-semibold text-secondary mb-6 uppercase tracking-wider">
          Standort-Vergleich
        </span>
        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">
          Welcher Hamburger Stadtteil passt zu Ihnen?
        </h1>
        <p class="text-lg lg:text-xl text-white/80 leading-relaxed max-w-2xl mx-auto">
          Drei Stadtteil-Paare, die Hamburger Eigentümer am häufigsten vergleichen — mit Mieten,
          Kaufpreisen, Erhaltungssatzung und Empfehlung.
        </p>
      </div>
    </Container>
  </section>

  {PAIRS.map((pair, idx) => (
    <section class={`py-16 ${idx % 2 === 1 ? 'bg-bg' : ''}`}>
      <Container>
        <SectionHeader
          badge={`Vergleich ${idx + 1}`}
          heading={`${pair.a.name} vs. ${pair.b.name}`}
          subheading={pair.winner}
          align="left"
        />
        <div class="max-w-5xl mx-auto">
          <div class="overflow-x-auto rounded-xl border border-border bg-surface">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-primary text-white text-left">
                  <th class="px-6 py-4 font-semibold">Kriterium</th>
                  <th class="px-6 py-4 font-semibold">
                    <a href={pair.a.href} class="hover:underline">{pair.a.name}</a>
                  </th>
                  <th class="px-6 py-4 font-semibold">
                    <a href={pair.b.href} class="hover:underline">{pair.b.name}</a>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr>
                  <td class="px-6 py-4 font-semibold text-text-primary">Kaufpreis</td>
                  <td class="px-6 py-4 text-text-secondary font-mono">{pair.a.kauf}</td>
                  <td class="px-6 py-4 text-text-secondary font-mono">{pair.b.kauf}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-semibold text-text-primary">Miete (DG)</td>
                  <td class="px-6 py-4 text-text-secondary font-mono">{pair.a.miete}</td>
                  <td class="px-6 py-4 text-text-secondary font-mono">{pair.b.miete}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-semibold text-text-primary">Erhaltungssatzung</td>
                  <td class="px-6 py-4 text-text-secondary">{pair.a.ehsg}</td>
                  <td class="px-6 py-4 text-text-secondary">{pair.b.ehsg}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-semibold text-text-primary">DG-Ausbau €/m²</td>
                  <td class="px-6 py-4 text-text-secondary font-mono">{pair.a.dgausbau}</td>
                  <td class="px-6 py-4 text-text-secondary font-mono">{pair.b.dgausbau}</td>
                </tr>
                <tr>
                  <td class="px-6 py-4 font-semibold text-text-primary">Stärke</td>
                  <td class="px-6 py-4 text-text-primary font-semibold">{pair.a.top}</td>
                  <td class="px-6 py-4 text-text-primary font-semibold">{pair.b.top}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="mt-4 flex gap-3">
            <a href={pair.a.href} class="text-primary hover:underline font-semibold text-sm">
              → {pair.a.name} im Detail
            </a>
            <span class="text-text-secondary">·</span>
            <a href={pair.b.href} class="text-primary hover:underline font-semibold text-sm">
              → {pair.b.name} im Detail
            </a>
          </div>
        </div>
      </Container>
    </section>
  ))}

  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="bg-primary rounded-2xl p-10 lg:p-14 text-white text-center">
          <h2 class="text-3xl font-bold mb-4">Welcher Stadtteil passt zu Ihrem Projekt?</h2>
          <p class="text-white/80 text-lg mb-8">
            Wir beraten kostenlos, welcher Hamburger Stadtteil für Ihren DG-Ausbau wirtschaftlich am sinnvollsten ist.
          </p>
          <LeadGenForm />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>