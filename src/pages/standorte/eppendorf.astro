---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import LeadGenForm from '@/components/forms/LeadGenForm.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import { generateLocalBusinessSchema, generateBreadcrumbSchema, generateServiceSchema } from '@/lib/schema';
---

<BaseLayout
  title="Dachgeschossausbau Eppendorf Hamburg – Gauben, Kosten, Genehmigung"
  description="Dachgeschossausbau in Hamburg Eppendorf: 1.800–2.500 €/m², Schleppgaube 8.000–18.000 €, Denkmalschutz beachten. HBauO 2026 §62 prüfen. Kostenlose Beratung."
  canonical="/standorte/eppendorf/"
  currentPath="/standorte/eppendorf/"
>
  <JsonLdSchema schema={JSON.stringify(generateLocalBusinessSchema())} />
  <JsonLdSchema schema={JSON.stringify(generateServiceSchema({ name: 'Dachgeschossausbau Eppendorf Hamburg', description: 'Dachgeschossausbau, Gauben und Dämmung in Eppendorf – alle Gewerke aus einer Hand.', slug: '/standorte/eppendorf/' }))} />
  <JsonLdSchema schema={JSON.stringify(generateBreadcrumbSchema([
    { name: 'Home', url: 'https://dachgeschossausbauhamburg.de/' },
    { name: 'Standorte', url: 'https://dachgeschossausbauhamburg.de/standorte/' },
    { name: 'Eppendorf', url: 'https://dachgeschossausbauhamburg.de/standorte/eppendorf/' },
  ]))} />

  <!-- ================================================
       HERO SECTION
       ================================================ -->
  <section class="bg-primary text-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 py-20 lg:py-28 items-start">
        <!-- Linke Spalte: Text -->
        <div>
          <span class="inline-block text-sm font-semibold text-secondary mb-6 uppercase tracking-wider">
            Hamburg · HBauO 2026 · Eppendorf
          </span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">
            Dachgeschossausbau Eppendorf Hamburg
          </h1>
          <p class="text-lg lg:text-xl text-white/80 leading-relaxed mb-8 max-w-xl">
            Eppendorf gehört zu den teuersten Wohnlagen Hamburgs. Jugendstil- und Gründerzeitbauten mit ungenutztem DG-Potenzial – bei Kaufpreisen von 5.000–8.000 €/m² und Mieten von 14–18 €/m². Nutzen Sie das Potenzial Ihres Daches.
          </p>
          <div class="space-y-3 text-sm text-white/70 mb-8">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>Handwerkerpreise 10–15% über Hamburger Durchschnitt</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>Erhaltungssatzungsgebiet – Gestaltungsauflagen beachten</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>HBauO 2026 §62 prüfen – Genehmigungsfreistellung möglich</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-4 text-center">
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">5.000–8.000</div>
              <div class="text-xs text-white/60 mt-1">Kaufpreis €/m²</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">14–18</div>
              <div class="text-xs text-white/60 mt-1">Miete €/m²</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">1.800–2.500</div>
              <div class="text-xs text-white/60 mt-1">DG-Ausbau €/m²</div>
            </div>
          </div>
        </div>

        <!-- Rechte Spalte: Formular -->
        <div class="lg:sticky lg:top-28 lg:max-w-lg lg:ml-auto">
          <LeadGenForm />
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 1: WARUM EPENDORF?
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <SectionHeader
          badge="Marktanalyse"
          heading="Warum Eppendorf?"
          headingLevel="h2"
          align="left"
        />
        <div class="max-w-none text-text-secondary space-y-4 content-area">
          <p class="text-lg leading-relaxed font-medium text-text-primary">
            Eppendorf gehört zu den teuersten Wohnvierteln Hamburgs. Die Nachfrage nach Wohnraum ist hier extrem hoch – und das Angebot entsprechend begrenzt.
          </p>
          <p>
            Der Stadtteil besticht durch seine Jugendstil- und Gründerzeitbauten, die häufig noch originales Dachgeschosspotenzial bieten. Kaufpreise von 5.000–8.000 €/m² und Mieten von 14–18 €/m² spiegeln die Lagequalität wider. Wer in Eppendorf ein Dachgeschoss ausbaut, schafft nicht nur Wohnfläche – er investiert in eine der wertstabilsten Lagen Hamburgs.
          </p>
          <p>
            Eppendorf gehört zum Bezirk Eimsbüttel-Nord und unterliegt der Erhaltungssatzungsverordnung. Das bedeutet: Jede Veränderung am äußeren Erscheinungsbild – auch eine Gaube – muss mit dem Bezirksamt abgestimmt werden. Das Bezirksamt Eimsbüttel hat viel Erfahrung mit Altbau-DG-Projekten. Mit dem richtigen Architekten und der richtigen Gaubenform (Schleppgaube ist in Eppendorf die bevorzugte Variante) stehen die Chancen gut.
          </p>
          <p>
            Ein weiterer Vorteil: Eppendorfer Grundstücke sind selten geworden. Dachgeschossausbau ist hier oft die einzige Möglichkeit, Wohnraum zu schaffen, ohne ein neues Grundstück erwerben zu müssen. Das macht ein DG-Projekt in Eppendorf besonders wertsteigernd – sowohl für die Eigennutzung als auch zur Vermietung.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 2: KOSTEN FR EPENDORF
       ================================================ -->
  <section class="py-20">
    <Container>
      <SectionHeader
        badge="Richtwerte"
        heading="Kosten für Dachgeschossausbau in Eppendorf"
        subheading="Hamburger Richtwerte mit Eppendorf-Aufschlag. Alle Preise inkl. Handwerker und Material."
      />
      <div class="max-w-3xl mx-auto content-area">
        <div class="overflow-x-auto rounded-xl border border-border mb-8">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-primary text-white text-left">
                <th class="px-6 py-4 font-semibold">Position</th>
                <th class="px-6 py-4 font-semibold text-right">Von</th>
                <th class="px-6 py-4 font-semibold text-right">Bis</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr class="bg-surface">
                <td class="px-6 py-4 font-medium">Einfacher DG-Ausbau</td>
                <td class="px-6 py-4 text-right font-mono">900 €/m²</td>
                <td class="px-6 py-4 text-right font-mono">1.400 €/m²</td>
              </tr>
              <tr class="bg-bg">
                <td class="px-6 py-4 font-medium">Komplettausbau</td>
                <td class="px-6 py-4 text-right font-mono">1.400 €/m²</td>
                <td class="px-6 py-4 text-right font-mono">2.000 €/m²</td>
              </tr>
              <tr class="bg-surface">
                <td class="px-6 py-4 font-medium">Premium-Ausbau (mit Gaube)</td>
                <td class="px-6 py-4 text-right font-mono">2.000 €/m²</td>
                <td class="px-6 py-4 text-right font-mono">2.800 €/m²</td>
              </tr>
              <tr class="bg-bg">
                <td class="px-6 py-4 font-medium">Schleppgaube</td>
                <td class="px-6 py-4 text-right font-mono">9.000 €</td>
                <td class="px-6 py-4 text-right font-mono">20.000 €</td>
              </tr>
              <tr class="bg-surface">
                <td class="px-6 py-4 font-medium">Fledermausgaube</td>
                <td class="px-6 py-4 text-right font-mono">16.000 €</td>
                <td class="px-6 py-4 text-right font-mono">28.000 €</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="max-w-none text-text-secondary space-y-4 content-area">
          <p>
            In Eppendorf liegen die Handwerkerpreise 10–15% ber dem Hamburger Durchschnitt. Das liegt an der hohen Nachfrage nach qualifizierten Betrieben in diesem Edelbezirk. Dazu kommen strengere Gestaltungsauflagen durch das Erhaltungssatzungsgebiet – die Planungskosten sind entsprechend höher.
          </p>
          <p>
            Wer eine Gaube plant, sollte mit 9.000–20.000 € für eine Schleppgaube rechnen. Die Fledermausgaube ist optisch reizvoller, kostet aber 16.000–28.000 €. Welche Gaubenform in Eppendorf genehmigungsfähig ist, hängt vom jeweiligen Bebauungsplan und der Zustimmung des Bezirksamts ab. Wir empfehlen, vor Planungsbeginn eine Bauvoranfrage zu stellen.
          </p>
          <p>
            Alle Hamburger Richtwerte und eine detaillierte Kostenaufstellung finden Sie auf unserer <a href="/kosten" class="text-primary font-semibold hover:underline">Kostenübersicht für Dachgeschossausbau in Hamburg</a>.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 3: GENEHMIGUNG IN EPENDORF
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <SectionHeader
          badge="Hamburger Recht"
          heading="Genehmigung in Eppendorf – Erhaltungssatzung beachten"
          headingLevel="h2"
          align="left"
        />
        <div class="max-w-none text-text-secondary space-y-4 content-area">
          <p class="text-lg leading-relaxed font-medium text-text-primary">
            Eppendorf gehört zum Erhaltungssatzungsgebiet Eimsbüttel-Nord. Das hat direkte Auswirkungen auf die Genehmigungsfähigkeit Ihres DG-Projekts.
          </p>
          <p>
            Die Hamburger Bauordnung 2026 (HBauO 2026) bietet mit §62 eine Genehmigungsfreistellung. Viele DG-Ausbaumaßnahmen – insbesondere Dämmung, Innenausbau und der Einbau von Dachflächenfenstern – können angezeigt werden und gelten nach vier Wochen als genehmigt. Die Kosten für diese Variante liegen bei 0–100 €.
          </p>
          <p>
            Sobald jedoch eine Gaube geplant ist, wird es komplizierter. Gauben verndern das ueres Erscheinungsbild des Gebäudes und benötigen in Erhaltungssatzungsgebieten eine separate Zustimmung des Bezirksamts. Das betrifft auch die Gaubenform: In Eppendorf sind Schleppgauben die bevorzugte Variante, die in der Regel auf Zustimmung stßt. Fledermausgauben oder Trapezgauben werden strenger geprüft.
          </p>
          <p>
            Fr das Genehmigungsverfahren in Eppendorf empfehlen wir, einen erfahrenen Architekten einzuschalten, der die Abstimmung mit dem Bezirksamt Eimsbüttel übernimmt. Die Bearbeitungszeit fr eine Gauben-Genehmigung in Erhaltungssatzungsgebieten beträgt in der Regel 4–8 Wochen.
          </p>
          <p>
            Mehr Informationen zur <a href="/genehmigung" class="text-primary font-semibold hover:underline">Genehmigungsfreistellung nach HBauO 2026</a> finden Sie auf unsererÜbersichtsseite.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 4: INTERNE VERLINKUNG
       ================================================ -->
  <section class="py-20">
    <Container>
      <SectionHeader
        badge="Mehr erfahren"
        heading="Zusammenhängende Themen"
        headingLevel="h2"
        align="left"
      />
      <div class="max-w-3xl mx-auto content-area">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a href="/kosten" class="group p-6 bg-surface rounded-xl border border-border hover:border-primary transition-colors">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">Hamburger Richtwerte fr DG-Ausbau</h3>
            <p class="text-sm text-text-secondary">Detaillierte Kostenaufstellung: 800–2.500 €/m², Gauben 8.000–25.000 €, Fördermittel.</p>
          </a>

          <a href="/genehmigung" class="group p-6 bg-surface rounded-xl border border-border hover:border-primary transition-colors">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">HBauO 2026 – Genehmigung leicht gemacht</h3>
            <p class="text-sm text-text-secondary">§62 Freistellung, §61 vereinfachtes Verfahren, Erhaltungssatzung, Denkmalschutz.</p>
          </a>

          <a href="/leistungen/dachgauben" class="group p-6 bg-surface rounded-xl border border-border hover:border-primary transition-colors">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">Dachgauben – Formen, Kosten, Genehmigung</h3>
            <p class="text-sm text-text-secondary">Schleppgaube, Fledermausgaube, Trapezgaube: Alle Varianten im Detail.</p>
          </a>

          <a href="/leistungen/daemmung" class="group p-6 bg-surface rounded-xl border border-border hover:border-primary transition-colors">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">Dämmung – Aufsparren, Zwischensparren</h3>
            <p class="text-sm text-text-secondary">U-Werte, Förderfhigkeit, KfW 261 und BAFA: Alle Dämmarten erklärt.</p>
          </a>

          <a href="/faq" class="group p-6 bg-surface rounded-xl border border-border hover:border-primary transition-colors">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">FAQ – 40+ Fragen und Antworten</h3>
            <p class="text-sm text-text-secondary">Von Kosten über Genehmigung bis Förderung: Alle wichtigen Fragen beantwortet.</p>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       END CTA SECTION
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <div class="bg-primary rounded-2xl p-10 lg:p-14 text-white text-center">
          <h2 class="text-3xl lg:text-4xl font-bold mb-4">
            Dachgeschossausbau in Eppendorf? Kostenlose Erstberatung.
          </h2>
          <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">
            Wir beraten Sie unverbindlich zu Ihrem DG-Projekt in Eppendorf – inklusive Kostenabschätzung und Genehmigungsprüfung nach HBauO 2026.
          </p>
          <LeadGenForm />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>