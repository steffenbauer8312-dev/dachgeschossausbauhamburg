---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import LeadGenForm from '@/components/forms/LeadGenForm.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import BreadcrumbList from '@/components/seo/BreadcrumbList.astro';
import { generateLocalBusinessSchema, generateBreadcrumbSchema, generateArticleSchema, generateFaqSchema } from '@/lib/schema';

const currentPath = '/ratgeber/vermieter/';

const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Ratgeber', href: '/ratgeber/' },
  { label: 'Vermieter & Investoren', href: '/ratgeber/vermieter/' },
];

const faqs = [
  {
    question: 'Lohnt sich DG-Ausbau als Kapitalanlage in Hamburg?',
    answer: 'Ja – unter bestimmten Bedingungen. In Eppendorf, Harvestehude und den Elbvororten liegt die Brutto-Mietrendite nach DG-Ausbau bei 7–9% auf den Gesamteinsatz. Hinzu kommt die Wertsteigerung von 8–15% auf das Gesamtobjekt, der Steuervorteil durch §35c (bis 40.000 €) und der Aufzugspflicht-Entfall nach HBauO 2026 (25.000–40.000 € gespart). In Randlagen wie Harburg oder Bergedorf ist die Rendite niedriger (5–7%), aber die KfW-Förderung (bis 45% Tilgungszuschuss) gleicht dies teilweise aus. DG-Ausbau als Kapitalanlage funktioniert am besten in Stadtteilen mit stabiler DG-Nachfrage – Eppendorf, Eimsbüttel, Altonaer Elbvororte.',
  },
  {
    question: 'Kann ich als Vermieter §35c EStG nutzen?',
    answer: 'Ja. Vermieter können §35c EStG sogar besser nutzen als Eigennutzer, weil die Kosten als Werbungskosten abgesetzt werden und so die steuerpflichtigen Mieteinnahmen senken. Der Steuervorteil wird über 3 Jahre in der Einkommensteuererklärung geltend gemacht (Anlage Vermietung). Voraussetzung: Die Handwerkerrechnung muss auf Sie als Eigentümer ausgestellt sein, und nur die Arbeitskosten zählen – nicht das Material. Bei einem 100.000-Euro-Ausbau mit 55.000 Euro Arbeitskosten und 42% Grenzsteuersatz sparen Sie rund 11.000 Euro über 3 Jahre. §35c und BAFA schließen sich gegenseitig aus – §35c und KfW 261 ebenfalls.',
  },
  {
    question: 'Wie hoch darf ich die Miete nach DG-Ausbau ansetzen?',
    answer: 'Nach einem DG-Ausbau können Sie die Miete auf zwei Wegen erhöhen: (1) Über die ortsübliche Vergleichsmiete (§558 BGB) – in Hamburgs Top-Lagen 18–25 €/m². (2) Über die Modernisierungsumlage (§559 BGB) – 11% der Modernisierungskosten pro Jahr umlegbar. Beispiel: 120.000 € Ausbau → 13.200 €/Jahr Umlage → 1.100 €/Monat Mietsteigerung. Achtung: Die Hamburger Kappungsgrenze begrenzt Mieterhöhungen im bestehenden Mietverhältnis auf 15% in 3 Jahren (in vielen Bezirken). Nutzen Sie die Staffelmiete (§557a BGB) bei Neuvermietung – so sind höhere Einstiegsmieten möglich. Die Modernisierungsumlage nach §559 ist nicht durch die Kappungsgrenze gedeckelt.',
  },
];

const articleSchema = generateArticleSchema({
  headline: 'Dachgeschossausbau als Kapitalanlage in Hamburg – Rendite, Steuervorteile, Risiken',
  description: 'Warum Hamburger Vermieter und Investoren auf DG-Ausbau setzen: Mieterträge, Steuerersparnis durch §35c EStG, Wertsteigerung. Realistische Rendite-Berechnung für Hamburg 2026.',
  datePublished: '2026-01-15',
  dateModified: '2026-05-13',
  url: 'https://dachgeschossausbauhamburg.de/ratgeber/vermieter/',
});
---

<BaseLayout
  title="Dachgeschossausbau als Kapitalanlage in Hamburg – Rendite, Steuervorteile, Risiken"
  description="Warum Hamburger Vermieter und Investoren auf DG-Ausbau setzen: Mieterträge, Steuerersparnis durch §35c EStG, Wertsteigerung. Realistische Rendite-Berechnung für Hamburg 2026."
  canonical="/ratgeber/vermieter/"
  currentPath={currentPath}
>
  <JsonLdSchema schema={JSON.stringify(generateLocalBusinessSchema())} />
  <JsonLdSchema schema={JSON.stringify(articleSchema)} />
  <JsonLdSchema schema={JSON.stringify(generateFaqSchema(faqs))} />
  <JsonLdSchema schema={JSON.stringify(generateBreadcrumbSchema([
    { name: 'Home', url: 'https://dachgeschossausbauhamburg.de/' },
    { name: 'Ratgeber', url: 'https://dachgeschossausbauhamburg.de/ratgeber/' },
    { name: 'Vermieter & Investoren', url: 'https://dachgeschossausbauhamburg.de/ratgeber/vermieter/' },
  ]))} />

  <BreadcrumbList items={breadcrumbItems} />

  <!-- ================================================
       HERO SECTION
       ================================================ -->
  <section class="bg-primary text-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 py-20 lg:py-28 items-start">
        <!-- Linke Spalte: Text -->
        <div>
          <span class="inline-block text-sm font-semibold text-secondary mb-6 uppercase tracking-wider">
            Hamburg · Kapitalanlage · Rendite · Steuervorteile
          </span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">
            Dachgeschossausbau als Kapitalanlage in Hamburg
          </h1>
          <p class="text-lg lg:text-xl text-white/80 leading-relaxed mb-8 max-w-xl">
            Warum Hamburger Vermieter und Investoren auf DG-Ausbau setzen – und warum die Rechnung trotz gestiegener Baukosten aufgeht.
          </p>
          <div class="space-y-3 text-sm text-white/70 mb-8">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>DG-Mieten Hamburg: €15–22/m² (Median bis Spitze)</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>Wertsteigerung nach Sanierung: 8–15% auf Gesamtobjekt</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>§35c Steuervorteil: bis 40.000 € über 3 Jahre</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>Aufzugspflicht entfällt → spart 25.000–40.000 €</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>HBauO 2026 macht Genehmigung einfacher</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-4 text-center">
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">7–9%</div>
              <div class="text-xs text-white/60 mt-1">Brutto-Rendite (Eppendorf)</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">40.000 €</div>
              <div class="text-xs text-white/60 mt-1">§35c Steuervorteil</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">15%</div>
              <div class="text-xs text-white/60 mt-1">Wertsteigerung (DG-Schnitt)</div>
            </div>
          </div>
        </div>

        <!-- Rechte Spalte: Formular -->
        <div class="lg:sticky lg:top-28 lg:max-w-lg lg:ml-auto">
          <div class="bg-primary text-white rounded-2xl p-5 lg:p-6">
            <h2 class="text-lg lg:text-xl font-bold mb-1">
              Beraten Sie mich als Kapitalanleger
            </h2>
            <p class="text-white/70 mb-5 text-xs">
              Rendite-Analyse für Ihr Hamburger Objekt – in 24 Stunden.
            </p>
            <LeadGenForm />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 1: WARUM DG-AUSBAU FÜR VERMIETER?
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          badge="Vorteile"
          heading="Warum DG-Ausbau für Vermieter?"
          subheading="Fünf Gründe, warum Hamburger Vermieter auf Dachgeschoss-Ausbau setzen."
          headingLevel="h2"
        />
        <div class="space-y-6">
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="text-primary font-bold text-lg">1</span>
            </div>
            <div>
              <h3 class="font-bold text-text-primary mb-1">Hamburger Mietmarkt: angespannt, DG-Nachfrage stabil hoch</h3>
              <p class="text-sm text-text-secondary">
                Der Hamburger Mietmarkt ist bundesweit unter den angespanntesten. Die Nachfrage nach Dachgeschosswohnungen ist besonders hoch, weil junge Berufstätige und Pendler den Charakter von DG-Wohnungen schätzen (Freiraum, Licht, Stadtlage). In Eppendorf, Eimsbüttel und den Elbvororten liegt die DG-Nachfrage stabil über dem Angebot – das bedeutet: niedrige Leerstandsquoten und regelmäßige Mieterhöhungen.
              </p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="text-primary font-bold text-lg">2</span>
            </div>
            <div>
              <h3 class="font-bold text-text-primary mb-1">Quadratmeter-Gewinn: Aus 60m² Nutzfläche werden 70–80m² Wohnfläche</h3>
              <p class="text-sm text-text-secondary">
                Der Ausbau eines DG-Rohbodens in eine vollwertige Wohnung ist die effizienteste Form der Flächenschaffung in Hamburg – ohne Grundstückskosten, ohne Stellplatzpflicht (bei DG nach HBauO 2026). Der Quadratmetergewinn liegt typischerweise bei 15–25% gegenüber der ursprünglichen Nutzfläche. Das bedeutet: mehr Mieteinnahmen pro Quadratmeter Grundstücksfläche.
              </p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="text-primary font-bold text-lg">3</span>
            </div>
            <div>
              <h3 class="font-bold text-text-primary mb-1">Aufzugskosten fallen nach HBauO 2026 weg</h3>
              <p class="text-sm text-text-secondary">
                Nach §37 Abs. 4 HBauO 2026 entfällt die Aufzugspflicht bei DG-Ausbau in bestehenden Gebäuden. Das spart 25.000–40.000 Euro – Kosten, die sonst die Rendite ruiniert hätten. Dieser Hamburger Vorteil gilt nur hier und macht den DG-Ausbau gegenüber Neubau in dieser Hinsicht deutlich wirtschaftlicher.
              </p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="text-primary font-bold text-lg">4</span>
            </div>
            <div>
              <h3 class="font-bold text-text-primary mb-1">Mieterhöhungspotenzial: Modernisierungsumlage nutzen</h3>
              <p class="text-sm text-text-secondary">
                Nach DG-Ausbau können Sie die DG-Miete auf Mietniveau des Neubaus anheben – über die ortsübliche Vergleichsmiete (§558 BGB) plus Modernisierungsumlage (§559 BGB). In der Praxis: 11% der Ausbaukosten pro Jahr auf die Miete umlegbar. Bei 120.000 Euro Ausbau sind das 13.200 Euro/Jahr = 1.100 Euro/Monat zusätzlich. Die Kappungsgrenze (15% in 3 Jahren) gilt nur für das bestehende Mietverhältnis – bei Neuvermietung sind höhere Einstiegsmieten möglich.
              </p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
              <span class="text-primary font-bold text-lg">5</span>
            </div>
            <div>
              <h3 class="font-bold text-text-primary mb-1">Hamburgs Mietpreisbremse: DG-Ausbau als Modernisierung → 11% Umlage möglich</h3>
              <p class="text-sm text-text-secondary">
                Die Hamburger Mietpreisbremse (§558 BGB) begrenzt Mieterhöhungen im Bestand auf 15% in 3 Jahren. Der DG-Ausbau umgeht dieses Limit teilweise: Über §559 BGB (Modernisierung) können Sie 11% der Kosten pro Jahr auf die Miete aufschlagen – und zwar oberhalb der Kappungsgrenze. Voraussetzung: Die Modernisierung muss eine nachhaltige Verbesserung darstellen (neue Gaube zählt, reine Instandsetzung nicht).
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 2: MIETERHÖHUNG NACH DG-AUSBAU
       ================================================ -->
  <section class="py-20">
    <Container>
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          badge="Mieterhöhung"
          heading="Mieterhöhung nach DG-Ausbau"
          subheading="§558 + §559 BGB: So erhöhen Sie die Miete rechtssicher nach dem Ausbau."
          headingLevel="h2"
          align="left"
        />
        <div class="prose prose-lg max-w-none text-text-secondary space-y-6">
          <p class="text-lg leading-relaxed font-medium text-text-primary">
            Nach einem DG-Ausbau haben Vermieter zwei Hebel für Mieterhöhungen: Die ortsübliche Vergleichsmiete (§558 BGB) und die Modernisierungsumlage (§559 BGB). Die Kombination beider Wege maximiert das Erhöhungspotenzial – ist aber an klare rechtliche Vorgaben gebunden.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-surface rounded-xl p-6 border border-border">
              <h3 class="font-bold text-text-primary mb-3">§558 BGB – Ortsübliche Vergleichsmiete</h3>
              <ul class="text-sm space-y-2">
                <li>Mieterhöhung bis zur ortsüblichen Vergleichsmiete</li>
                <li>In Hamburgs Top-Lagen: 18–25 €/m² netto kalt</li>
                <li>Begrenzt durch Kappungsgrenze: 15% in 3 Jahren (Bestandsmieter)</li>
                <li>Bei Neuvermietung: freie Preisgestaltung (ortsüblich = Marktniveau)</li>
              </ul>
            </div>
            <div class="bg-surface rounded-xl p-6 border border-border">
              <h3 class="font-bold text-text-primary mb-3">§559 BGB – Modernisierungsumlage</h3>
              <ul class="text-sm space-y-2">
                <li>11% der Modernisierungskosten/Jahr auf Miete umlegbar</li>
                <li>Nicht durch Kappungsgrenze begrenzt!</li>
                <li>Beispiel: 120.000 € → 13.200 €/Jahr = 1.100 €/Monat</li>
                <li>Mieter muss 2 Monate vor Erhöhung informiert werden (§559 Abs. 4)</li>
              </ul>
            </div>
          </div>

          <h3 class="text-xl font-bold text-text-primary">Praxisbeispiel: Mieterhöhung nach DG-Ausbau</h3>
          <div class="bg-primary rounded-2xl p-8 text-white">
            <div class="prose prose-lg max-w-none text-white/80">
              <p><strong class="text-white">Szenario:</strong> DG-Ausbau in Eppendorf, 70m² Wohnfläche.</p>
              <ul class="space-y-2 my-4">
                <li>Kaufpreis DG-Anteil (geschätzt): 45.000 €</li>
                <li>Ausbaukosten: 120.000 €</li>
                <li>Gesamteinsatz: 165.000 €</li>
                <li>Vorher-Miete: 580 €/Monat (8,29 €/m²)</li>
                <li>Nachher-Miete (Vergleichsmiete): 980 €/Monat (14 €/m²)</li>
                <li>Modernisierungsumlage (§559): +1.100 €/Monat</li>
                <li>Gesamtmiete nach Ausbau: <strong class="text-secondary">2.080 €/Monat</strong></li>
              </ul>
              <p class="mt-4 text-white/80">
                <strong class="text-white">Anmerkung:</strong> Die Modernisierungsumlage ist nicht durch die Kappungsgrenze gedeckelt, muss aber als eigenständige Erhöhung neben der Vergleichsmiete geltend gemacht werden. Häufig ist eine Stufen-Mieterhöhung über 3 Jahre sinnvoll, um den Mieter nicht zu überfordern und den Cashflow zu glätten.
              </p>
            </div>
          </div>

          <h3 class="text-xl font-bold text-text-primary">Kappungsgrenze beachten</h3>
          <p>
            In Hamburg gelten je nach Bezirk unterschiedliche Kappungsgrenzen. In vielen Bezirken (Eimsbüttel, Hamburg-Nord, Altona) gilt die 15%-Regel innerhalb von 3 Jahren für Bestandsmieter. Das bedeutet: Wenn Ihre aktuelle Miete 600 € beträgt, können Sie in 3 Jahren maximal auf 690 € erhöhen – plus die Modernisierungsumlage nach §559, die davon unabhängig ist.
          </p>
          <p>
            <strong class="text-text-primary">Bei Neuvermietung:</strong> Die Kappungsgrenze gilt nicht. Sie können die Miete frei auf ortsübliches Niveau setzen. Nutzen Sie die Staffelmiete nach §557a BGB – so haben Sie als Vermieter Planungssicherheit und der Mieter透明的 Kostenentwicklung.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 3: §35c ESTG – STEUERVORTEIL FÜR VERMIETER
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          badge="Steuervorteil"
          heading="§35c EStG – Steuervorteil für Vermieter"
          subheading="20% der Handwerkerrechnungen absetzen – für Vermieter oft attraktiver als für Eigennutzer."
          headingLevel="h2"
          align="left"
        />
        <div class="prose prose-lg max-w-none text-text-secondary space-y-6">
          <p class="text-lg leading-relaxed font-medium text-text-primary">
            Vermieter haben einen entscheidenden Steuervorteil bei §35c EStG gegenüber Eigennutzern: Die Kosten werden als Werbungskosten abgesetzt und senken die steuerpflichtigen Mieteinnahmen. Das erhöht den effektiven Steuervorteil – besonders für Vermieter mit hohem Grenzsteuersatz.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-surface rounded-xl p-6 border border-border">
              <h3 class="font-bold text-text-primary mb-3">So funktioniert es</h3>
              <ul class="text-sm space-y-2">
                <li>20% der Handwerkerrechnungen absetzbar</li>
                <li>Maximal 40.000 € über 3 Jahre (13.333 €/Jahr)</li>
                <li>Über Werbungskosten → senkt steuerpflichtige Mieteinnahmen</li>
                <li>Nur Arbeitskosten (nicht Material!)</li>
                <li>Handwerkerrechnung muss aufschlüsseln</li>
              </ul>
            </div>
            <div class="bg-surface rounded-xl p-6 border border-border">
              <h3 class="font-bold text-text-primary mb-3">Warum besser für Vermieter?</h3>
              <ul class="text-sm space-y-2">
                <li>Vermieter haben oft höheren Grenzsteuersatz</li>
                <li>Werbungskosten mindern Einkommen aus Vermietung</li>
                <li>Effektiver Steuervorteil = 20% × Grenzsteuersatz</li>
                <li>Bei 42% Steuersatz: effektiv 8,4% der Arbeitskosten gespart</li>
                <li>Eigennutzer: Steuervorteil zählt nur gegen Einkommensteuer</li>
              </ul>
            </div>
          </div>

          <h3 class="text-xl font-bold text-text-primary">Beispiel: 100.000 € Ausbau</h3>
          <div class="bg-primary rounded-2xl p-8 text-white">
            <div class="prose prose-lg max-w-none text-white/80">
              <ul class="space-y-2">
                <li>Gesamtkosten: 100.000 €</li>
                <li>Arbeitskosten (geschätzt 50–60%): ca. 55.000 €</li>
                <li>§35c: 20% auf 55.000 € = 11.000 € über 3 Jahre</li>
                <li>Bei 42% Grenzsteuersatz: effektive Ersparnis ~4.620 €</li>
              </ul>
              <p class="mt-4 text-white font-semibold">
                Nur Arbeitskosten zählen! Die Handwerkerrechnung muss Material und Arbeitskosten separat ausweisen.
              </p>
            </div>
          </div>

          <div class="bg-surface border border-border rounded-xl p-6">
            <div class="flex items-start gap-4">
              <svg class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
              <div>
                <p class="text-sm text-text-secondary">
                  <strong class="text-text-primary">Wichtig:</strong> §35c EStG und BAFA BEG EM schließen sich gegenseitig aus – Sie müssen sich für eines entscheiden. §35c und KfW 261 ebenfalls. Für Vermieter mit hohem Steuersatz ist §35c oft die bessere Wahl, weil der effektive Steuervorteil die Förderung übersteigt.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 4: RENDITE-BERECHNUNG
       ================================================ -->
  <section class="py-20">
    <Container>
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          badge="Rendite"
          heading="Rendite-Berechnung – Drei Szenarien"
          subheading="Konkrete Zahlen für typische Hamburger DG-Investments 2026."
          headingLevel="h2"
          align="left"
        />

        <!-- Szenario A -->
        <div class="bg-surface rounded-2xl p-8 border border-border mb-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-lg">A</span>
            <div>
              <h3 class="text-xl font-bold text-text-primary">Einfacher Ausbau (Eppendorf, 55m²)</h3>
              <p class="text-sm text-text-secondary">Bestes Szenario: Top-Lage, einfacher Ausbau, hohe Mieteinnahmen.</p>
            </div>
          </div>
          <div class="overflow-x-auto rounded-xl border border-border mb-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-primary/5 text-left">
                  <th class="px-4 py-3 font-semibold text-text-primary">Position</th>
                  <th class="px-4 py-3 font-semibold text-text-primary text-right">Betrag</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
