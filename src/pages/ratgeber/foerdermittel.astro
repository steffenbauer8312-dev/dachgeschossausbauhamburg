                  </span>
                </summary>
                <div class="px-6 pb-6 text-sm text-text-secondary leading-relaxed">
                  {faq.answer}
                </div>
              </details>
            </div>
          ))}
        </div>

        <div class="mt-6 text-center">
          <p class="text-sm text-text-secondary">
            Weitere Fragen? <a href="/faq" class="text-primary font-semibold hover:underline">Alle FAQ ansehen</a> oder uns direkt kontaktieren.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       CTA SECTION
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto">
        <div class="bg-primary rounded-2xl p-10 lg:p-14 text-white text-center">
          <h2 class="text-3xl lg:text-4xl font-bold mb-4">
