---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import LeadGenForm from '@/components/forms/LeadGenForm.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import { generateLocalBusinessSchema, generateBreadcrumbSchema, generateArticleSchema, generateFaqSchema } from '@/lib/schema';

const faqs = [
  {
    question: "Kann ich BAFA und KfW 261 kombinieren?",
    answer: "BAFA und KfW 261 sind nicht direkt kombinierbar, da beide aus dem gleichen Topf (BEG) kommen. Sie müssen sich für einen Weg entscheiden: Entweder KfW 261 (Kredit + Tilgungszuschuss für Komplettsanierung auf Effizienzhaus-Standard) oder BAFA (Zuschuss für Einzelmaßnahmen). §35c EStG ist eine Alternative zu BAFA, nicht kumulierbar – aber BAFA und §35c schließen sich gegenseitig aus. Wer die KfW 261 nutzt, kann §35c ebenfalls nicht nutzen."
  },
  {
    question: "Was wenn ich schon mit der Planung angefangen habe?",
    answer: "Fördermittel dürfen NICHT für Maßnahmen beantragt werden, die vor der Antragstellung bereits begonnen oder beauftragt wurden. Das gilt für alle drei Programme (KfW 261, BAFA, §35c). Wenn Sie bereits mit einem Architekten oder Handwerker gesprochen haben, ist das noch kein Problem – solange noch keine Aufträge erteilt wurden. Sobald ein Auftrag unterschrieben ist, verfällt der Anspruch auf Förderung. Informieren Sie uns frühzeitig – wir helfen Ihnen, die richtige Reihenfolge einzuhalten."
  },
  {
    question: "Gilt §35c EStG auch für Vermieter?",
    answer: "Ja. §35c EStG ist auch für Vermieter nutzbar, die das Dachgeschoss vermieten. Die Steuerermäßigung kann über Werbungskosten geltend gemacht werden – als Nachtrag in der Einkommensteuererklärung über drei Jahre verteilt. Voraussetzung: Die Handwerkerrechnung muss auf Sie als Eigentümer ausgestellt sein, und nur die Arbeitskosten (nicht Material) zählen. Bei Vermietung werden die Kosten als Werbungskosten abgesetzt, was den Steuervorteil in der Praxis sogar erhöhen kann."
  }
];

const articleSchema = generateArticleSchema({
  headline: "Fördermittel für Dachgeschossausbau in Hamburg 2026 – KfW 261, BAFA, §35c EStG",
  description: "Umfassender Ratgeber zu Fördermitteln für Dachgeschossausbau in Hamburg: KfW 261 Wohngebäude-Kredit, BAFA BEG EM Einzelmaßnahmen und §35c EStG. Bis zu 45% Tilgungszuschuss sichern.",
  datePublished: "2026-01-15",
  dateModified: "2026-05-13",
  url: "https://dachgeschossausbauhamburg.de/ratgeber/foerdermittel/"
});
---

<BaseLayout
  title="Fördermittel für Dachgeschossausbau Hamburg 2026 – KfW 261, BAFA, §35c"
  description="Hamburg 2026: Förderkulisse besser als je zuvor. KfW bis 150.000 €/Wohneinheit, BAFA bis 12.000 €, §35c EStG bis 40.000 €. Jetzt Förderung sichern!"
  canonical="/ratgeber/foerdermittel/"
  currentPath="/ratgeber/foerdermittel/"
>
  <JsonLdSchema schema={JSON.stringify(generateLocalBusinessSchema())} />
  <JsonLdSchema schema={JSON.stringify(articleSchema)} />
  <JsonLdSchema schema={JSON.stringify(generateFaqSchema(faqs))} />
  <JsonLdSchema schema={JSON.stringify(generateBreadcrumbSchema([
    { name: 'Home', url: 'https://dachgeschossausbauhamburg.de/' },
    { name: 'Ratgeber', url: 'https://dachgeschossausbauhamburg.de/ratgeber/' },
    { name: 'Fördermittel', url: 'https://dachgeschossausbauhamburg.de/ratgeber/foerdermittel/' },
  ]))} />

  <!-- ================================================
       HERO SECTION
       ================================================ -->
  <section class="bg-primary text-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 py-20 lg:py-28 items-start">
        <!-- Linke Spalte: Text -->
        <div>
          <span class="inline-block text-sm font-semibold text-secondary mb-6 uppercase tracking-wider">
            Hamburg · Förderung 2026 · KfW · BAFA · §35c
          </span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">
            Fördermittel für Dachgeschossausbau in Hamburg
          </h1>
          <p class="text-lg lg:text-xl text-white/80 leading-relaxed mb-8 max-w-xl">
            Hamburg 2026: Die Förderkulisse für Dachgeschossausbau ist besser als je zuvor. Wir zeigen Ihnen, wie Sie bis zu 45% Tilgungszuschuss sichern und Ihre Baukosten deutlich senken.
          </p>
          <div class="space-y-3 text-sm text-white/70 mb-8">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span><strong class="text-white">KfW 261:</strong> bis 150.000 € je Wohneinheit, 5–45% Tilgungszuschuss</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span><strong class="text-white">BAFA:</strong> bis 12.000 € Zuschuss pro Wohneinheit (15–20%)</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span><strong class="text-white">§35c EStG:</strong> bis 40.000 € Steuervorteil über 3 Jahre (20%)</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-4 text-center">
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">150.000 €</div>
              <div class="text-xs text-white/60 mt-1">KfW 261 max./WE</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">45%</div>
              <div class="text-xs text-white/60 mt-1">Tilgungszuschuss</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">40.000 €</div>
              <div class="text-xs text-white/60 mt-1">§35c Steuervorteil</div>
            </div>
          </div>
        </div>

        <!-- Rechte Spalte: Formular -->
        <div class="lg:sticky lg:top-28 lg:max-w-lg lg:ml-auto">
          <LeadGenForm />
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 1: WARUM FÖRDERMITTEL JETZT BESONDERS RELEVANT SIND
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          badge="Marktentwicklung"
          heading="Warum Fördermittel jetzt besonders relevant sind"
          subheading="Hamburg 2026: Vier Faktoren machen den DG-Ausbau jetzt so attraktiv wie nie."
          headingLevel="h2"
        />
        <div class="prose prose-lg max-w-none text-text-secondary space-y-6">
          <p class="text-lg leading-relaxed font-medium text-text-primary">
            Die Hamburger Förderlandschaft hat sich in den letzten Jahren grundlegend verändert. Wer jetzt plant, profitiert von einer Kombination aus günstigen Krediten, hohen Zuschüssen und steuerlichen Vorteilen – und das bei einem Hamburger Mietmarkt, der eine Value-Add-Strategie beim DG-Ausbau besonders rentabel macht.
          </p>

          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold text-lg">1</span>
              </div>
              <div>
                <h3 class="font-bold text-text-primary mb-1">CO₂-Preis 2026: 65 €/Tonne</h3>
                <p class="text-sm text-text-secondary">
                  Mit dem CO₂-Preis von 65 Euro pro Tonne (ab 2026) steigen die Betriebskosten für unsanierte Altbauten deutlich. Eine energieeffiziente Sanierung beim DG-Ausbau amortisiert sich dadurch schneller denn je. Der CO₂-Preis ist ein permanenter Preisanstieg – jede Kilowattstunde Heizenergie, die Sie durch Dämmung einsparen, spart Ihnen direkt Geld.
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold text-lg">2</span>
              </div>
              <div>
                <h3 class="font-bold text-text-primary mb-1">HBauO 2026 macht DG-Ausbau einfacher</h3>
                <p class="text-sm text-text-secondary">
                  Die neue Hamburger Bauordnung (HBauO) reduziert die Genehmigungshürden erheblich. Die Genehmigungsfreistellung nach §62 HBauO für Ein- und Zweifamilienhäuser im Bereich eines qualifizierten Bebauungsplans bedeutet: Bauvorlage einreichen, einen Monat warten, loslegen. Das erhöht die Zahl der Anträge – und erhöht den Wettbewerb um Handwerker. Jetzt sichern Sie sich die besten Betriebe, bevor der Ansturm kommt.
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold text-lg">3</span>
              </div>
              <div>
                <h3 class="font-bold text-text-primary mb-1">Hamburger Mietmarkt: DG-Mieten Median 15,12 €/m²</h3>
                <p class="text-sm text-text-secondary">
                  Der Hamburger Mietmarkt ist angespannt. Der Median für Dachgeschosswohnungen liegt bei 15,12 Euro pro Quadratmeter – und steigt. In Stadtteilen wie Eppendorf, Harvestehude, Eimsbüttel und den Elbvororten werden Spitzenmieten von 20 bis 28 Euro/m² erzielt. Ein DG-Ausbau schafft nicht nur Wohnraum, sondern eine Value-Add-Opportunity mit erheblichem Mietertrag und Wertsteigerung nach Sanierung.
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="text-primary font-bold text-lg">4</span>
              </div>
              <div>
                <h3 class="font-bold text-text-primary mb-1">Handwerkerpreise Hamburg: 10–15% über Bundesdurchschnitt</h3>
                <p class="text-sm text-text-secondary">
                  Hamburg ist einer der teuersten Handwerkermärkte Deutschlands. Die Löhne und Materialpreise liegen 10 bis 15 Prozent über dem Bundesdurchschnitt. Das macht den DG-Ausbau hier teurer als in anderen Großstädten – aber genau deshalb sind die Fördermittel hier umso wichtiger. Ein Tilgungszuschuss von 15 oder 20 Prozent auf eine 120.000-Euro-Maßnahme kann den Unterschied machen zwischen einem Loch in der Kasse und einem profitablen Projekt.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 2: DIE DREI SÄULEN DER HAMBURGER FÖRDERUNG
       ================================================ -->
  <section class="py-20">
    <Container>
      <SectionHeader
        badge="Förderübersicht"
        heading="Die drei Säulen der Hamburger Förderung"
        subheading="KfW 261, BAFA BEG EM und §35c EStG – so funktioniert die Hamburger Förderarchitektur 2026."
      />
      <div class="max-w-4xl mx-auto">
        <div class="overflow-x-auto rounded-xl border border-border mb-8">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-primary text-white text-left">
                <th class="px-6 py-4 font-semibold">Programm</th>
                <th class="px-6 py-4 font-semibold text-right">Max. Betrag</th>
                <th class="px-6 py-4 font-semibold text-right">Zuschuss</th>
                <th class="px-6 py-4 font-semibold">Für wen</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr class="bg-surface">
                <td class="px-6 py-4 font-medium text-text-primary">
                  <span class="font-bold">KfW 261</span><br />
                  <span class="text-xs text-text-secondary">Wohngebäude-Kredit</span>
                </td>
                <td class="px-6 py-4 text-right font-mono text-text-primary">150.000 €/WE</td>
                <td class="px-6 py-4 text-right font-mono text-secondary font-bold">5–45% Tilgungszuschuss</td>
                <td class="px-6 py-4 text-xs text-text-secondary">Komplettsanierung auf Effizienzhaus-Standard</td>
              </tr>
              <tr class="bg-bg">
                <td class="px-6 py-4 font-medium text-text-primary">
                  <span class="font-bold">BAFA BEG EM</span><br />
                  <span class="text-xs text-text-secondary">Einzelmaßnahmen</span>
                </td>
                <td class="px-6 py-4 text-right font-mono text-text-primary">60.000 €/WE</td>
                <td class="px-6 py-4 text-right font-mono text-secondary font-bold">15% (mit iSFP 20%)</td>
                <td class="px-6 py-4 text-xs text-text-secondary">Einzelmaßnahmen: Dämmung, Gaube, Fenster, Elektrik, Heizung</td>
              </tr>
              <tr class="bg-surface">
                <td class="px-6 py-4 font-medium text-text-primary">
                  <span class="font-bold">§35c EStG</span><br />
                  <span class="text-xs text-text-secondary">Steuerliche Absetzung</span>
                </td>
                <td class="px-6 py-4 text-right font-mono text-text-primary">40.000 € / 3 Jahre</td>
                <td class="px-6 py-4 text-right font-mono text-secondary font-bold">20% der Arbeitskosten</td>
                <td class="px-6 py-4 text-xs text-text-secondary">Eigentümer für Handwerkerrechnungen (Steuerzahler)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="bg-bg border border-border rounded-xl p-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-sm text-text-secondary">
                <strong class="text-text-primary">Wichtig:</strong> Alle drei Programme sind untereinander eingeschränkt kombinierbar. BAFA und §35c EStG schließen sich gegenseitig aus – Sie müssen sich für eines entscheiden. KfW 261 und BAFA sind ebenfalls nicht kombinierbar, da beide aus dem gleichen Fördertopf (BEG) stammen. KfW 261 und §35c schließen sich ebenfalls aus. Die Wahl des richtigen Programms hängt von Ihrem Projekt und Ihrer Steuersituation ab.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ================================================
       SECTION 3: KFW 261 – DETAIL
       ================================================ -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto">
        <SectionHeader
          badge="KfW Programm 261"
          heading="KfW 261 – Der Wohngebäude-Kredit"
          subheading="Der komplexeste, aber auch attraktivste Förderbaustein – ideal für Investoren und Eigentümer mit Sanierungsambitionen."
          headingLevel="h2"
          align="left"
        />

        <div class="space-y-8">
          <!-- Wie es funktioniert -->
          <div class="prose prose-lg max-w-none text-text-secondary">
            <h3 class="text-xl font-bold text-text-primary mb-3">Wie es funktioniert</h3>
            <p>
              Der KfW 261 ist ein Kredit, der mit einem Tilgungszuschuss kombiniert wird. Der Tilgungszuschuss ist ein nicht zurückzahlbarer Zuschuss – er wird auf Ihren Kredit angerechnet und reduziert Ihre Gesamtschuld. Sie erhalten ihn, wenn Sie den Effizienzhaus-Standard erreichen.
            </p>
          </div>

          <!-- Kredithöhe -->
          <div class="bg-primary rounded-2xl p-8 text-white">
            <h3 class="text-xl font-bold mb-4">Kredithöhe und Tilgungszuschuss</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-white/20 text-left">
                    <th class="pb-3 font-semibold">Effizienzhaus-Stufe</th>
                    <th class="pb-3 font-semibold text-right">Tilgungszuschuss</th>
                    <th class="pb-3 font-semibold text-right">Max. Zuschuss</th>
                    <th class="pb-3 font-semibold text-right">+ EE-Klasse</th>
                    <th class="pb-3 font-semibold text-right">Max. mit EE</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/10">
                  <tr>
                    <td class="py-3 font-medium">EH 85</td>
                    <td class="py-3 text-right font-mono">5%</td>
                    <td class="py-3 text-right font-mono text-secondary">6.000 €</td>
                    <td class="py-3 text-right font-mono">+5% = 10%</td>
                    <td class="py-3 text-right font-mono text-secondary">15.000 €</td>
                  </tr>
                  <tr>
                    <td class="py-3 font-medium">EH 70</td>
                    <td class="py-3 text-right font-mono">10%</td>
                    <td class="py-3 text-right font-mono text-secondary">12.000 €</td>
                    <td class="py-3 text-right font-mono">+5% = 15%</td>
                    <td class="py-3 text-right font-mono text-secondary">22.500 €</td>
                  </tr>
                  <tr>
                    <td class="py-3 font-medium">EH 55</td>
                    <td class="py-3 text-right font-mono">15%</td>
                    <td class="py-3 text-right font-mono text-secondary">18.000 €</td>
                    <td class="py-3 text-right font-mono">+5% = 20%</td>
                    <td class="py-3 text-right font-mono text-secondary">30.000 €</td>
                  </tr>
                  <tr>
                    <td class="py-3 font-medium">EH 40</td>
                    <td class="py-3 text-right font-mono">20%</td>
                    <td class="py-3 text-right font-mono text-secondary">24.000 €</td>
                    <td class="py-3 text-right font-mono">+5% = 25%</td>
                    <td class="py-3 text-right font-mono text-secondary">37.500 €</td>
                  </tr>
                  <tr>
                    <td class="py-3 font-medium">EH Denkmal</td>
                    <td class="py-3 text-right font-mono">5%</td>
                    <td class="py-3 text-right font-mono text-secondary">6.000 €</td>
                    <td class="py-3 text-right font-mono">+5% = 10%</td>
                    <td class="py-3 text-right font-mono text-secondary">15.000 €</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Boni -->
          <div class="prose prose-lg max-w-none text-text-secondary">
            <h3 class="text-xl font-bold text-text-primary mb-3">Boni – kumulierbar!</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-surface rounded-xl p-5 border border-border">
                <div class="text-lg font-bold text-primary mb-1">+5% EE-Klasse</div>
                <p class="text-sm text-text-secondary">Heizung mit mind. 65% erneuerbare Energien (Wärmepumpe, Solar, Biomasse). Wird auf den Tilgungszuschuss oben draufgerechnet.</p>
              </div>
              <div class="bg-surface rounded-xl p-5 border border-border">
                <div class="text-lg font-bold text-primary mb-1">+10% WPB-Bonus</div>
                <p class="text-sm text-text-secondary">Worst Performing Building: Gebäude mit einem Energiebedarf von mindestens 160 kWh/(m²a). Gilt für Altbauten vor 1977 besonders häufig.</p>
              </div>
              <div class="bg-surface rounded-xl p-5 border border-border">
                <div class="text-lg font-bold text-primary mb-1">+15% Serielle Sanierung</div>
                <p class="text-sm text-text-secondary">Komplette vorgefertigte Dachelemente, montagefertig angeliefert. Reduziert die Baustellenzeit und erhöht die Förderung deutlich.</p>
              </div>
            </div>
          </div>

          <!-- Praxisbeispiel -->
          <div class="bg-surface rounded-2xl p-8 border border-border">
            <h3 class="text-xl font-bold text-text-primary mb-4">Praxisbeispiel: DG-Ausbau in Eimsbüttel</h3>
            <div class="prose prose-lg max-w-none text-text-secondary">
              <p>
                <strong class="text-text-primary">Szenario:</strong> Altbau in Eimsbüttel (Baujahr 1975), Dachgeschoss-Ausbau mit Wärmepumpe. Die Zielklasse ist EH 70 mit EE-Klasse.
              </p>
              <ul class="space-y-2 my-4">
                <li>Kredithöhe: 120.000 € (volle Auslastung)</li>
                <li>Tilgungszuschuss: 15% (EH 70) + 5% (EE-Klasse) = 20%</li>
                <li>Tilgungszuschuss: 24.000 € – nicht zurückzahlbar!</li>
                <li>Tatsächliche Kreditbelastung: 96.000 €</li>
              </ul>
              <p class="bg-primary/10 rounded-lg p-4 font-semibold text-text-primary">
                Ergebnis: 24.000 € geschenkt. Sie zahlen nur 96.000 € zurück, nicht 120.000 €.
              </p>
            </div>
          </div>

          <!-- Voraussetzungen -->
          <div class="prose prose-lg max-w-none text-text-secondary">
            <h3 class="text-xl font-bold text-text-primary mb-3">Voraussetzungen</h3>
            <ul class="space-y-2">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span><strong class="text-text-primary">Energieeffizienz-Experte:</strong> Sie benötigen einen zertifizierten Energieberater aus der dena-Liste. Die Kosten für die Baubegleitung sind selbst förderfähig (50%, max. 5.000 €).</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span><strong class="text-text-primary">Antrag VOR Auftragserteilung:</strong> Sie müssen den KfW 261-Antrag stellen, bevor Sie Aufträge erteilen. Der Antrag wird über Ihre Hausbank eingereicht – nicht direkt bei der KfW.</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span><strong class="text-text-primary">Laufzeit:</strong> 4–30 Jahre, 1–5 tilgungsfreie Anlaufjahre. Zinssatz aktuell ab ca. 2,24% effektiv (Stand 2026).</span>
              </li>
            </ul>
