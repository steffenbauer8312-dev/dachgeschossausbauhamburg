---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import LeadGenForm from '@/components/forms/LeadGenForm.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import BreadcrumbList from '@/components/seo/BreadcrumbList.astro';
import { generateLocalBusinessSchema, generateBreadcrumbSchema, generateArticleSchema, generateFaqSchema } from '@/lib/schema';

const currentPath = '/ratgeber/dachsanierung/';

const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Ratgeber', href: '/ratgeber/' },
  { label: 'Dachsanierung Hamburg', href: '/ratgeber/dachsanierung/' },
];

const faqs = [
  {
    question: 'Was kostet eine Dachsanierung in Hamburg?',
    answer: 'Die Kosten für eine Dachsanierung in Hamburg (2025/2026) liegen je nach Umfang zwischen 120 und 350 Euro pro Quadratmeter Dachfläche. Einfache Neueindeckung mit Dämmung: 120–180 €/m². Komplette Sanierung inklusive Aufsparrendämmung: 200–350 €/m². Hinzu kommen: Gerüst 1.500–4.000 €, Gauben 8.000–25.000 €, Statik-Gutachten 500–2.000 €. Für ein typisches Hamburger Satteldach (120 m²) liegen die Gesamtkosten zwischen 15.000 und 45.000 Euro.',
  },
  {
    question: 'Wann lohnt sich eine Dachsanierung in Hamburg?',
    answer: 'Eine Dachsanierung lohnt sich in Hamburg, wenn mindestens eines der folgenden Kriterien zutrifft: Das Dach ist älter als 30 Jahre und zeigt Alterungserscheinungen (Moos, poröse Ziegel, Korrosion). Es gibt Undichtigkeiten oder Feuchteschäden im Dachgeschoss. Die Dämmung entspricht nicht dem GEG (Gebäudeenergiegesetz) – besonders relevant nach den verschärften Anforderungen 2024/2025. Eine Dachsanierung mit energetischer Verbesserung ist förderfähig durch KfW 261 und BAFA, was die Gesamtkosten um bis zu 25 Prozent senken kann.',
  },
  {
    question: 'Dachsanierung oder Dachgeschossausbau – was ist besser?',
    answer: 'Die Entscheidung hängt von Ihrem Ziel ab: Wenn Sie rein die Bausubstanz sichern wollen (Feuchteschutz, Wärmedämmung, Werterhalt), ist eine Dachsanierung ohne Ausbau ausreichend und günstiger. Wenn Sie zusätzlich neuen Wohnraum gewinnen wollen, ist der DG-Ausbau die wirtschaftlichere Wahl – denn die Sanierungskosten fallen ohnehin an, und der Ausbau schafft nutzbare Fläche. In Hamburg gelten für beide Vorhaben unterschiedliche Genehmigungsregeln: Die Sanierung allein ist oft genehmigungsfrei nach §62 HBauO 2026, der DG-Ausbau kann ein vereinfachtes Verfahren nach §63 HBauO 2026 erfordern.',
  },
  {
    question: 'Welche Fördermittel gibt es für Dachsanierung in Hamburg?',
    answer: 'Für die energetische Dachsanierung in Hamburg gibt es vier Förderwege: KfW 261 (Wohngebäude-Kredit) mit Tilgungszuschuss bis 25 % der Kosten und zinsgünstigen Darlehen bis 150.000 € je Wohneinheit. BAFA-Einzelmaßnahmen mit direkten Zuschüssen für Dämmmaßnahmen an der Dachfläche (bis zu 4.500 € je Maßnahme, bis 12.000 € mit iSFP). §35c EStG für energetische Modernisierungsmaßnahmen – 20 % aller Kosten (Material + Lohn) direkt von der Steuerlast absetzbar, max. 40.000 € über 3 Jahre (7 % + 7 % + 6 %). IFB Hamburg Wärmeschutz-Zuschüsse mit bis zu 58,30 €/m² für Steildachdämmung. Die Hamburger Energielotsen bieten eine kostenlose Vor-Ort-Beratung zu Fördermitteln und Sanierungsfahrplänen.',
  },
  {
    question: 'Wie lange dauert eine Dachsanierung in Hamburg?',
    answer: 'Eine Dachsanierung in Hamburg dauert je nach Umfang ein bis vier Wochen. Einfache Neueindeckung: 1–2 Wochen. Sanierung mit Dämmung: 2–3 Wochen. Komplette Sanierung inklusive Gauben: 3–4 Wochen. Die Vorlaufzeit für Planung, Statik-Gutachten und eventuelle Genehmigung beträgt zusätzlich 4–12 Wochen. HBauO 2026 ermöglicht für einfache Sanierungen (Neueindeckung ohne Gauben) eine genehmigungsfreie Durchführung nach §62 – das spart 4–8 Wochen Genehmigungszeit.',
  },
];

const kostenRows = [
  { position: 'Neueindeckung Satteldach (Ziegel)', einheit: 'm²', vonPreis: 80, bisPreis: 140 },
  { position: 'Neueindeckung Flachdach (Bitumen/PVC)', einheit: 'm²', vonPreis: 60, bisPreis: 120 },
  { position: 'Zwischensparrendämmung (Mineralwolle, Dampfbremse)', einheit: 'm²', vonPreis: 60, bisPreis: 120 },
  { position: 'Aufsparrendämmung (inkl. Neubedachung)', einheit: 'm²', vonPreis: 120, bisPreis: 250 },
  { position: 'Dachflächenfenster (VELUX, Roto)', einheit: 'Stück', vonPreis: 400, bisPreis: 1500 },
  { position: 'Schleppgaube (inkl. Anschlüsse)', einheit: 'Stück', vonPreis: 8000, bisPreis: 18000 },
  { position: 'Fledermausgaube (inkl. Anschlüsse)', einheit: 'Stück', vonPreis: 15000, bisPreis: 25000 },
  { position: 'Gerüst', einheit: 'pauschal', vonPreis: 1500, bisPreis: 4000 },
  { position: 'Statik-Gutachten', einheit: 'pauschal', vonPreis: 500, bisPreis: 2000 },
];

const schritte = [
  { label: 'Bestandsanalyse', desc: 'Zustand, Alter, Schäden, Statik prüfen' },
  { label: 'Planung & Konzept', desc: 'Sanierungsumfang, Kostenrahmen, Förderantrag' },
  { label: 'HBauO-Prüfung', desc: 'Genehmigungsfreiheit nach §62 oder vereinfachtes Verfahren' },
  { label: 'Angebote einholen', desc: '3 Vergleichsangebote, Festpreise vereinbaren' },
  { label: 'Umsetzung', desc: 'Koordination aller Gewerke, Bauleitung' },
  { label: 'Abnahme & Doku', desc: 'Endkontrolle, Rechnungsprüfung, Förderabrechnung' },
];
---

<BaseLayout
  title="Dachsanierung Hamburg 2025/2026 – Kosten, Förderung, Genehmigung"
  description="Dachsanierung Hamburg: Aktuelle Kosten 120–350 €/m², KfW 261 + BAFA Förderung, HBauO 2026 Genehmigungsregeln. Alles über Sanierung vs. DG-Ausbau in Hamburg."
  canonical="/ratgeber/dachsanierung/"
  currentPath={currentPath}
>
  <JsonLdSchema schema={JSON.stringify(generateLocalBusinessSchema())} />
  <JsonLdSchema schema={JSON.stringify(generateBreadcrumbSchema([
    { name: 'Home', url: 'https://dachgeschossausbauhamburg.de/' },
    { name: 'Ratgeber', url: 'https://dachgeschossausbauhamburg.de/ratgeber/' },
    { name: 'Dachsanierung Hamburg – Kosten, Förderung, Genehmigung', url: 'https://dachgeschossausbauhamburg.de/ratgeber/dachsanierung/' },
  ]))} />
  <JsonLdSchema schema={JSON.stringify(generateArticleSchema({
    headline: 'Dachsanierung Hamburg 2025/2026 – Kosten, Förderung, Genehmigung',
    description: 'Was kostet eine Dachsanierung in Hamburg? Welche Fördermittel gibt es? Wann ist eine Genehmigung nötig? Und wann lohnt sich die Kombination mit einem DG-Ausbau?',
    datePublished: '2026-05-14',
    dateModified: '2026-05-14',
    author: 'Dachgeschossausbau Hamburg',
    url: 'https://dachgeschossausbauhamburg.de/ratgeber/dachsanierung/',
  }))} />
  <JsonLdSchema schema={JSON.stringify(generateFaqSchema(faqs))} />

  <BreadcrumbList items={breadcrumbItems} />

  <!-- HERO -->
  <section class="bg-primary text-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 py-20 lg:py-28 items-start">
        <div>
          <span class="inline-block text-sm font-semibold text-secondary mb-6 uppercase tracking-wider">
            Hamburg · GEG 2024 · KfW 261 · HBauO 2026
          </span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">
            Dachsanierung Hamburg<br />
            <span class="text-secondary">– Was kostet es, was lohnt sich?</span>
          </h1>
          <p class="text-lg lg:text-xl text-white/80 leading-relaxed mb-8 max-w-xl">
            Hamburger Dachflächen sind Wind, Regen und salzhaltiger Seeluft ausgesetzt. Das setzt dem Dach zu – und macht regelmäßige Sanierungen notwendig. Dieser Ratgeber zeigt aktuelle Kostenrichtwerte, Fördermöglichkeiten und die Entscheidung zwischen reiner Sanierung und Kombination mit einem DG-Ausbau.
          </p>
          <div class="space-y-3 text-sm text-white/70 mb-8">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>Hamburger Kostenrichtwerte 2025/2026: 120–350 €/m²</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>KfW 261 + BAFA Förderung: bis zu 25 % der Sanierungskosten</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>HBauO 2026: Sanierung oft genehmigungsfrei nach §62</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>GEG 2024: verschärfte Pflichtwerte für Dachdämmung</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-4 text-center">
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">120–350 €</div>
              <div class="text-xs text-white/60 mt-1">pro m² Dachfläche</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">bis 25 %</div>
              <div class="text-xs text-white/60 mt-1">Förderung möglich</div>
            </div>
            <div class="bg-white/10 rounded-xl p-4">
              <div class="text-2xl font-bold text-secondary">1–4 Wochen</div>
              <div class="text-xs text-white/60 mt-1">reine Bauzeit</div>
            </div>
          </div>
        </div>
        <div class="lg:sticky lg:top-28 lg:max-w-lg lg:ml-auto">
          <LeadGenForm />
        </div>
      </div>
    </Container>
  </section>

  <!-- SECTION 1: Was ist Dachsanierung -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <SectionHeader
          badge="Grundlagen"
          heading="Was ist eine Dachsanierung – und was nicht?"
          subheading="Der Begriff wird oft verwechselt. Hier die klare Abgrenzung."
          headingLevel="h2"
          align="left"
        />
        <div class="max-w-none text-text-secondary space-y-4 content-area">
          <p class="text-lg leading-relaxed font-medium text-text-primary">
            Eine <strong>Dachsanierung</strong> umfasst alle Maßnahmen zur Wiederherstellung oder Verbesserung der Funktionsfähigkeit eines Daches – ohne dass zusätzlicher Wohnraum geschaffen wird. Das Ziel ist der Erhalt der Bausubstanz, die Verbesserung der Wärmedämmung und der Schutz vor Witterungseinflüssen. Eine Sanierung kann punktuell sein (Reparatur einzelner Schäden) oder umfassend (komplette Neueindeckung inklusive Dämmung).
          </p>
          <p>
            Der <strong>Dachgeschossausbau</strong> (auch „Dachausbau Hamburg" genannt) geht einen Schritt weiter: Er schafft neuen, nutzbaren Wohnraum im Dachgeschoss. Das kann eine Erweiterung des bestehenden Dachgeschosses sein (Gauben, Aufstockung) oder die erstmalige Herrichtung einer unbewohnten Dachfläche zur Wohnnutzung. DG-Ausbau und Sanierung werden dabei häufig kombiniert, weil die Sanierungskosten ohnehin anfallen und der Ausbau Synergien nutzt.
          </p>
          <div class="p-5 bg-primary/5 border border-primary/20 rounded-xl my-6">
            <h3 class="font-bold text-text-primary mb-2">Wann sprechen wir von „Dachsanierung Hamburg"?</h3>
            <p class="text-sm text-text-secondary">In diesem Ratgeber geht es um die klassische <strong>punktuelle oder flächige Sanierung</strong> bestehender Dächer: Neueindeckung, Dämmung, Austausch von Fenstern und Gauben-Reparatur. Wenn Sie zusätzlich Wohnraum gewinnen wollen, lesen Sie parallel unseren Ratgeber zum <a href="/ratgeber/prozess/" class="text-primary underline hover:underline">DG-Ausbau in Hamburg</a>.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- SECTION 2: Kosten Hamburg 2026 -->
  <section class="py-20">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <SectionHeader
          badge="Kosten"
          heading="Dachsanierung Hamburg – Kostenrichtwerte 2025/2026"
          subheading="Hamburger Marktpreise. Die genauen Kosten hängen von Zustand, Dachform und Umfang ab."
          headingLevel="h2"
        />
        <div class="overflow-x-auto rounded-xl border border-border mb-8">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-primary text-white">
                <th class="px-6 py-4 font-semibold text-left">Maßnahme</th>
                <th class="px-6 py-4 font-semibold text-right">Einheit</th>
                <th class="px-6 py-4 font-semibold text-right">Von</th>
                <th class="px-6 py-4 font-semibold text-right">Bis</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {kostenRows.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-surface' : 'bg-bg'}>
                  <td class="px-6 py-4 font-medium">{row.position}</td>
                  <td class="px-6 py-4 text-right text-text-secondary">{row.einheit}</td>
                  <td class="px-6 py-4 text-right font-mono">{row.vonPreis.toLocaleString('de-DE')} €</td>
                  <td class="px-6 py-4 text-right font-mono">{row.bisPreis.toLocaleString('de-DE')} €</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="max-w-none text-text-secondary space-y-4 content-area">
          <p>
            <strong>Beispiel:</strong> Für ein typisches Hamburger Satteldach (120 m² Dachfläche) ergeben sich folgende Richtwerte: Neueindeckung mit Zwischensparrendämmung: 18.000–30.000 €. Mit Aufsparrendämmung und Gauben: 35.000–60.000 €. Gerüst, Statik und Genehmigungen kommen zusätzlich hinzu (2.000–6.000 €).
          </p>
          <p>
            Die Hamburger Preise liegen rund 10–15 Prozent über dem Bundesdurchschnitt. Das liegt an den spezifischen Anforderungen der maritimen Klimazone: higher Windlasten, erhöhte Feuchtigkeitsbelastung und die Verwendung besonders witterungsbeständiger Materialien. Im Gegenzug profitieren Hamburger Bauherren von der <a href="https://www.hamburg.de/bbauo/" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:underline">Aufhebung der Aufzugspflicht nach §37 Abs. 4 HBauO</a> – im Vergleich zu anderen Bundesländern spart das bei DG-Projekten bis zu 30.000 Euro.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- SECTION 3: Wann lohnt sich Sanierung -->
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <SectionHeader
          badge="Entscheidungshilfe"
          heading="Wann lohnt sich eine Dachsanierung – und wann ein DG-Ausbau?"
          subheading="Die richtige Entscheidung hängt von Ziel, Zustand und Budget ab."
          headingLevel="h2"
          align="left"
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <div class="p-6 bg-surface rounded-xl border border-border">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
            </div>
            <h3 class="text-xl font-bold text-text-primary mb-3">Nur Sanierung – wenn...</h3>
            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Das Dach ist undicht, aber das DG wird nicht genutzt</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Die Raumhöhe im DG reicht nicht für Wohnzwecke (unter 2,30 m)</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Der Zustand des Dachstuhls lässt keinen Ausbau zu</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Sie den Wohnraum nicht erweitern wollen (Mietrecht, Erbschaftssteuer)</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Das Gebäude ist denkmalgeschützt und Ausbau ist genehmigungstechnisch nicht möglich</span>
              </li>
            </ul>
          </div>
          <div class="p-6 bg-surface rounded-xl border border-border">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            </div>
            <h3 class="text-xl font-bold text-text-primary mb-3">Sanierung + DG-Ausbau – wenn...</h3>
            <ul class="space-y-2 text-sm text-text-secondary">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Sie zusätzlichen Wohnraum gewinnen wollen (Familie, Homeoffice, Vermietung)</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Die Raumhöhe im DG beträgt mindestens 2,30 m über 2/3 der Fläche</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Der Dachstuhl ist statisch ausreichend oder ertüchtigbar</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Sie die Hamburger Mietpreise für DG-Flächen nutzen wollen (Median 15,12 €/m²)</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                <span>Sie von §35c EStG und KfW 261 gleichzeitig profitieren wollen</span>
              </li>
            </ul>
          </div>
        </div>
        <div class="p-5 bg-primary/5 border border-primary/20 rounded-xl">
          <p class="text-sm text-text-primary font-medium">
            <strong>Tipp:</strong> Wenn eine Sanierung ohnehin ansteht, prüfen Sie frühzeitig, ob der DG-Ausbau wirtschaftlich Sinn ergibt. Die Kombination nutzt Synergien bei Gerüst, Dachöffnung und Gewerkekoordination – und die Gesamtkosten fallen günstiger aus als zwei getrennte Projekte. <a href="/kosten" class="text-primary underline hover:underline">Kostenvergleich Dachausbau Hamburg →</a>
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- SECTION 4: GEG Pflichtwerte -->
  <section class="py-20">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <SectionHeader
          badge="GEG 2024"
          heading="Das Gebäudesenergiegesetz (GEG) – Pflichtwerte für Hamburg"
          subheading="Seit 2024 gelten verschärfte Anforderungen. Das ist für Ihre Sanierung relevant. U-Wert ≤0,20 W/(m²K) bei Neudeckung."
          headingLevel="h2"
          align="left"
        />
        <div class="max-w-none text-text-secondary space-y-4 content-area">
          <p class="text-lg leading-relaxed font-medium text-text-primary">
            Das GEG 2024 hat die Pflichtwerte für die Dämmung bei Sanierungen verschärft. Das betrifft jede Dachsanierung, die über eine reine Reparatur hinausgeht – insbesondere, wenn die Dacheindeckung erneuert wird.
          </p>
          <p>
            Für die <strong>Dachsanierung in Hamburg</strong> gelten nach <a href="https://www.geg-rechner.de/" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:underline">GEG 2024</a> folgende Pflichtwerte: Bei Ersatz der gesamten Dachhaut muss die Dämmung einen U-Wert von maximal <strong>0,20 W/(m²K)</strong> erreichen (10-%-Regel). Bei bestehender Nachrüstpflicht (Dach ungedämmt): U-Wert max. <strong>0,24 W/(m²K)</strong>. Für Denkmäler und Gebäude in Erhaltungssatzungsgebieten gibt es Sonderregelungen mit niedrigeren Pflichtwerten – hier berät das <a href="https://www.hamburg.de/denkmalschutz/" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:underline">Denkmalschutzamt Hamburg</a> in Abstimmung mit der Energieberatung.
          </p>
          <p>
            <strong>PV-Pflicht in Hamburg:</strong> Seit dem 1. Januar 2023 müssen bei grundlegender Dachsanierung oder DG-Ausbau Photovoltaik-Anlagen installiert werden – auch auf Dächern mit einer nutzbaren Fläche von mindestens 50 m². Die <a href="https://www.hamburg.de/pv-pflicht/" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:underline">Hamburger PV-Pflicht</a> gilt seit 01.01.2024 für alle Neubauten und grundlegenden Dachsanierungen. Prüfen Sie frühzeitig, ob eine PV-Installation auf Ihrem Dach sinnvoll ist – das reduziert die Energiekosten langfristig.
          </p>
          <p>
            <strong>Warum ist das für Hamburg besonders relevant?</strong> Die maritime Klimazone mit hoher Feuchtigkeitsbelastung und Windlast erfordert robuste Dämmsysteme. Aufsparrendämmung mit hochwertigen Mineralwolle- oder Holzfaser-Dämmstoffen erreichen die GEG-Pflichtwerte zuverlässig und bieten zusätzlich einen verbesserten sommerlichen Hitzeschutz – ein Thema, das in Hamburg mit seinen zunehmend heißen Sommern immer wichtiger wird.
          </p>
          <div class="overflow-x-auto rounded-xl border border-border my-6">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-primary text-white">
                  <th class="px-6 py-4 font-semibold text-left">Dämmart</th>
                  <th class="px-6 py-4 font-semibold text-right">U-Wert (W/m²K)</th>
                  <th class="px-6 py-4 font-semibold text-right">GEG 2024-konform?</th>
