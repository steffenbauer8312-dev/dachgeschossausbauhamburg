---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import FaqAccordion from '@/components/content/FaqAccordion.astro';
import CostTable from '@/components/content/CostTable.astro';
import StepsOverview from '@/components/content/StepsOverview.astro';
import BreadcrumbList from '@/components/seo/BreadcrumbList.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import { generateServiceSchema, generateFaqSchema } from '@/lib/schema';

const pageTitle = 'Dachgeschossausbau für Eigentümer in München – Kosten, Genehmigung, Förderung 2026';
const pageDescription = 'Ihr Dachgeschoss ausbauen als Eigentümer in München? Kosten, Genehmigung (Bayern 2025), Förderungen (KfW/BAFA), Dämmung und Denkmalschutz – alles erklärt.';

const serviceSchemaStr = JSON.stringify(generateServiceSchema({
  name: 'Dachgeschossausbau für Eigentümer – München',
  description: pageDescription,
  slug: '/leistungen/dachgeschossausbau-eigentuemer/',
}));

const faqs = [
  { question: 'Was kostet ein Dachgeschossausbau für Eigentümer in München?', answer: 'Die Kosten liegen je nach Zustand des Dachgeschosses und gewünschtem Ausstattungsstandard zwischen 500 und 1.800 €/m² Nutzfläche. Einfache Ausbauten starten ab ca. 500 €/m². Komplette Sanierungen mit Bad, Elektrik und Heizung liegen bei 1.200–1.800 €/m². Für ein 50-m²-Dachgeschoss sind 40.000–90.000 € realistisch.' },
  { question: 'Welche Genehmigung brauche ich für den Dachgeschossausbau in Bayern?', answer: 'Seit der Bayerischen Bauordnung 2025 sind Ausbauten verfahrensfrei, wenn die Dachkonstruktion und die äußere Gestalt nicht verändert werden. Für Gauben, Aufstockungen oder Nutzungsänderungen ist ein Bauantrag bei der Lokalbaukommission München nötig.' },
  { question: 'Welche Förderungen kann ich als Eigentümer nutzen?', answer: 'KfW 261 fördert energetische Sanierungen mit bis zu 20% Zuschuss. BAFA-Zuschüsse gibt es für Dämmung, Fenster und Heizung. Auch steuerliche Abschreibung (Sanierungs-AfA) ist möglich. Bei denkmalgeschützten Gebäuden greift die Denkmalschutz-AfA.' },
  { question: 'Wie lange dauert ein Dachgeschossausbau in München?', answer: 'Die reine Bauzeit beträgt 6–16 Wochen je nach Umfang. Hinzu kommen 4–12 Wochen für Planung und Genehmigung. Verfahrensfreie Ausbauten sind in 8–16 Wochen Gesamtdauer machbar.' },
  { question: 'Lohnt sich der Dachgeschossausbau auch bei einem Denkmal?', answer: 'Ja, bei denkmalgeschützten Gebäuden. Die Kombination aus Wertsteigerung und steuerlicher Abschreibung (Denkmalschutz-AfA) macht den Ausbau oft wirtschaftlicher als bei nicht geschützten Gebäuden.' },
  { question: 'Brauche ich einen Architekten für den Dachgeschossausbau?', answer: 'Bei verfahrensfreien Ausbauten ist kein Architekt zwingend nötig. Bei Gauben, Aufstockungen, Nutzungsänderungen oder denkmalgeschützten Gebäuden ist ein Architekt oder Bauvorlageberechtigter erforderlich.' },
  { question: 'Welche Dämmung ist für ein Dachgeschoss in München vorgeschrieben?', answer: 'Das GEG fordert für ausgebaute Dachgeschosse eine Dämmung, die den aktuellen U-Wert-Anforderungen entspricht. Zwischensparrendämmung (60–100 €/m²), Untersparrendämmung (30–95 €/m²) oder Aufsparrendämmung (100–250 €/m² inkl. Neueindeckung) kommen zum Einsatz.' },
  { question: 'Was passiert mit Fledermäusen im Dach?', answer: 'In München muss vor jedem Dachgeschossausbau geprüft werden, ob das Dach als Lebensraum für Fledermäuse dient. Ist das der Fall, muss das Referat für Klima und Umweltschutz kontaktiert werden (naturschutz.rku@muenchen.de).' },
];

const faqSchemaStr = JSON.stringify(generateFaqSchema(faqs));

const costRows = [
  { position: 'Rückbau & Entsorgung', einheit: 'm²', vonPreis: 30, bisPreis: 65 },
  { position: 'Zwischensparrendämmung (inkl. Folie)', einheit: 'm² Dachfläche', vonPreis: 60, bisPreis: 100 },
  { position: 'Trockenbau (Dachschrägen, Decke)', einheit: 'm²', vonPreis: 40, bisPreis: 70 },
  { position: 'Innenwände (leichte Trennwände)', einheit: 'm² Wand', vonPreis: 80, bisPreis: 130 },
  { position: 'Bodenaufbau (Estrich + Trittschalldämmung)', einheit: 'm²', vonPreis: 70, bisPreis: 120 },
  { position: 'Bodenbelag (Vinyl, Laminat, Parkett)', einheit: 'm²', vonPreis: 40, bisPreis: 120 },
  { position: 'Elektro komplett neu', einheit: 'm² Nutzfläche', vonPreis: 80, bisPreis: 150 },
  { position: 'Heizung (Anschluss + Heizkörper)', einheit: 'pauschal', vonPreis: 2000, bisPreis: 5000 },
  { position: 'Malerarbeiten', einheit: 'm² Wandfläche', vonPreis: 12, bisPreis: 25 },
];

const steps = [
  { number: 1, title: 'Potenzial-Check', description: 'Wir analysieren Ihr Dachgeschoss: Statik, Dachneigung, Lichtverhältnisse und Genehmigungsoptionen.' },
  { number: 2, title: 'Kostenrahmen', description: 'Sie erhalten einen realistischen Kostenrahmen auf Basis Ihrer Wünsche und des Ist-Zustands.' },
  { number: 3, title: 'Fachbetriebs-Vermittlung', description: 'Wir wählen 1–3 passende Fachbetriebe aus und koordinieren die Angebotsphase.' },
  { number: 4, title: 'Umsetzung', description: 'Die Betriebe setzen um – wir stehen während der gesamten Bauzeit als Ansprechpartner zur Seite.' },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/leistungen/dachgeschossausbau-eigentuemer/"
  currentPath="/leistungen/dachgeschossausbau-eigentuemer/"
>
  <JsonLdSchema schema={serviceSchemaStr} />
  <JsonLdSchema schema={faqSchemaStr} />
  <BreadcrumbList items={[{ label: 'Leistungen', href: '/leistungen' }, { label: 'Dachgeschossausbau für Eigentümer' }]} />

  <section class="bg-bg py-16">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-block text-sm font-medium text-secondary mb-4">Leistungen</span>
        <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-6">
          Dachgeschossausbau für Eigentümer in München
        </h1>
        <p class="text-xl text-text-secondary leading-relaxed mb-6">
          Sie möchten Ihren Dachboden in wertvollen Wohnraum verwandeln? Als Eigentümer
          in München stehen Sie vor besonderen Herausforderungen: Bayerische Bauordnung,
          Denkmalschutz, Münchner Grundstückspreise. Wir helfen Ihnen, das Potenzial
          Ihres Dachgeschosses optimal zu nutzen – kostenfrei und transparent.
        </p>
        <a href="/kontakt" class="cta-primary">Kostenlose Beratung anfragen</a>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="max-w-3xl space-y-12">
        <div>
          <h2 class="text-2xl font-bold mb-4 text-text-primary">Was ist ein Dachgeschossausbau?</h2>
          <p class="text-text-secondary leading-relaxed">
            Der Dachgeschossausbau bezeichnet die Umwandlung eines unbewohnten Dachgeschosses – meist ein Speicher oder Bodenraum – in vollwertigen Wohnraum. Anders als ein einfacher Dachausbau, bei dem lediglich die Dachhülle erneuert wird, umfasst der Dachgeschossausbau die komplette Innengestaltung: Dämmung, Wände, Böden, Elektrik, Heizung und sanitäre Installationen.
          </p>
          <p class="text-text-secondary leading-relaxed mt-4">
            In München, wo der Quadratmeterpreis für Wohnraum 5.000 bis 10.000 € übersteigt, ist der Ausbau des eigenen Dachgeschosses für Immobilieneigentümer oft wirtschaftlich sinnvoll. Mit Kosten von 500–1.800 €/m² schaffen Sie Wohnraum zu einem Bruchteil des Neubaupreises.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-4 text-text-primary">Wann lohnt sich der Dachgeschossausbau?</h2>
          <p class="text-text-secondary leading-relaxed mb-4">Ein Dachgeschossausbau lohnt sich, wenn folgende Bedingungen erfüllt sind:</p>
          <ul class="space-y-2 text-text-secondary">
            <li class="flex items-start gap-3"><span class="text-primary font-bold mt-1">→</span><span><strong>Dachneigung ab 25°</strong> – ausreichend Stehhöhe im Kniestock und First</span></li>
            <li class="flex items-start gap-3"><span class="text-primary font-bold mt-1">→</span><span><strong>Statisch tragfähig</strong> – die bestehende Deckenkonstruktion kann das zusätzliche Gewicht aufnehmen</span></li>
            <li class="flex items-start gap-3"><span class="text-primary font-bold mt-1">→</span><span><strong>Zugang möglich</strong> – das Dachgeschoss ist über das Treppenhaus erreichbar</span></li>
            <li class="flex items-start gap-3"><span class="text-primary font-bold mt-1">→</span><span><strong>Genehmigungsfähig</strong> – kein Ausschluss durch Bebauungsplan oder Denkmalschutz</span></li>
            <li class="flex items-start gap-3"><span class="text-primary font-bold mt-1">→</span><span><strong>Wirtschaftlich sinnvoll</strong> – Ausbaukosten deutlich unter dem Münchner Wohnungspreis</span></li>
          </ul>
        </div>

        <div>
          <StepsOverview steps={steps} />
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-4 text-text-primary">Dachgeschossausbau Kosten in München 2026</h2>
          <p class="text-text-secondary leading-relaxed mb-6">
            Die Richtwerte gelten für den Großraum München. Die tatsächlichen Kosten hängen
            vom Zustand der Bausubstanz ab, von der gewünschten Ausstattung und davon,
            ob ein Bad integriert werden soll.
          </p>
          <CostTable rows={costRows} />
          <p class="text-sm text-text-secondary mt-4">
            Sie möchten eine detaillierte Kostenanalyse für Ihr Projekt?
            <a href="/kontakt" class="text-primary font-semibold hover:underline ml-2">Kostenlose Beratung anfragen →</a>
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-4 text-text-primary">Genehmigung in Bayern – Was hat sich 2025 geändert?</h2>
          <p class="text-text-secondary leading-relaxed">
            Die neue Bayerische Bauordnung, die im Januar 2025 in Kraft getreten ist, hat den Dachgeschossausbau vereinfacht. Verfahrensfrei sind nun Ausbauten zu Wohnzwecken, wenn die Dachkonstruktion und die äußere Gestalt des Gebäudes nicht verändert werden.
          </p>
          <h3 class="text-lg font-semibold mt-6 mb-3 text-text-primary">Wann brauchen Sie einen Bauantrag?</h3>
          <ul class="space-y-2 text-text-secondary">
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span>Einbau von Dachgauben, die die Gebäudesilhouette verändern</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span>Aufstockung oder Erweiterung der Dachform</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span>Nutzungsänderung von Nutz- zu Wohnraum (in der Regel immer genehmigungspflichtig)</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span>Eingriffe in die Tragwerkskonstruktion (Statik)</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span>Veränderungen an denkmalgeschützten Gebäuden</span></li>
          </ul>
          <p class="text-text-secondary leading-relaxed mt-4">
            Bei der Lokalbaukommission München (LBK) müssen verfahrensfreie Ausbauten zwei Wochen vor Baubeginn in Textform angezeigt werden. Wir begleiten Sie durch den gesamten Prozess.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-4 text-text-primary">Förderungen für Eigentümer in München</h2>
          <p class="text-text-secondary leading-relaxed">
            Staatliche Fördermittel senken die Kosten Ihres Dachgeschossausbaus deutlich. Bei einem 50.000-€-Projekt können Sie mit 5.000 bis 10.000 € an Zuschüssen rechnen.
          </p>
          <ul class="space-y-3 mt-4 text-text-secondary">
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span><strong>KfW 261:</strong> Bis zu 20% Zuschuss für energetische Sanierung, inkl. Dämmung und Fenster</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span><strong>BAFA-Einzelmaßnahmen:</strong> Zuschüsse für Dämmung (40–65 €/m² Dachfläche), Heizung, Fenster</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span><strong>Sanierungs-AfA:</strong> Steuerliche Abschreibung über 10 Jahre bei umfassender energetischer Sanierung</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span><strong>Denkmalschutz-AfA:</strong> Bei denkmalgeschützten Gebäuden erhöhte Abschreibung (§7i EStG)</span></li>
            <li class="flex items-start gap-3"><span class="text-secondary font-bold mt-1">•</span><span><strong>Landesförderung Bayern:</strong> Ergänzende Programme der bayerischen Landesförderbank</span></li>
          </ul>
        </div>

        <FaqAccordion faqs={faqs} headingLevel="h2" />

        <div class="bg-primary rounded-2xl p-8 text-center text-white">
          <h2 class="text-2xl font-bold mb-4">Kostenlose Erstberatung anfragen</h2>
          <p class="text-white/70 mb-6">Erzählen Sie uns von Ihrem Projekt – wir melden uns innerhalb von 24 Stunden.</p>
          <a href="/kontakt" class="cta-primary text-base">Zum Kontaktformular</a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>