---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import LeadGenForm from '@/components/forms/LeadGenForm.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import { generateLocalBusinessSchema, generateServiceSchema, generateBreadcrumbSchema, generateFaqSchema } from '@/lib/schema';

const pageTitle = 'Dachaufstockung Hamburg – Mehrgeschoss-Aufstockung, Kosten, Genehmigung';
const pageDescription = 'Dachaufstockung Hamburg: Ein zusätzliches Vollgeschoss auf Bestandsgebäuden – Holzbau, Modulbau oder Massivbau. Kosten 2.500–4.500 €/m², HBauO 2026, Statik & Förderung.';

const serviceSchemaStr = JSON.stringify(generateServiceSchema({
  name: 'Dachaufstockung Hamburg',
  description: pageDescription,
  slug: '/leistungen/dachaufstockung/',
}));

const faqSchemaStr = JSON.stringify(generateFaqSchema([
  {
    question: 'Was kostet eine Dachaufstockung in Hamburg pro m²?',
    answer: 'Eine Dachaufstockung in Hamburg kostet zwischen 2.500 und 4.500 Euro pro Quadratmeter Wohnfläche – abhängig von Konstruktionsart (Holzbau günstiger als Massivbau), Erschließungsaufwand (neue Treppe, ggf. Aufzug) und Statik. Ein zusätzliches Vollgeschoss mit 80 m² liegt typischerweise zwischen 200.000 und 360.000 Euro schlüsselfertig.'
  },
  {
    question: 'Brauche ich für eine Dachaufstockung in Hamburg eine Baugenehmigung?',
    answer: 'Ja, eine Dachaufstockung ist in Hamburg immer genehmigungspflichtig. Sie verändert die Kubatur des Gebäudes und erfordert ein vereinfachtes Baugenehmigungsverfahren nach §61 HBauO 2026. Eine Genehmigungsfreistellung nach §62 ist nicht möglich, da das Vorhaben die Außenwände und die Gebäudehöhe berührt. Die Bearbeitungszeit beim Bezirksamt beträgt 8–12 Wochen.'
  },
  {
    question: 'Welche Häuser eignen sich für eine Dachaufstockung in Hamburg?',
    answer: 'Am besten eignen sich Flachdach-Bauten aus den 1960er- und 1970er-Jahren, deren Tragwerk für ein zusätzliches Geschoss ausgelegt oder verstärkt werden kann. Auch Satteldach-Häuser mit niedriger Firsthöhe sind geeignet – hier wird das Dach angehoben. Weniger geeignet sind denkmalgeschützte Gebäude, Häuser in Erhaltungssatzungsgebieten mit strengen Gestaltungsregeln sowie Bauten mit unzureichender Statik.'
  },
  {
    question: 'Welche Förderung gibt es für eine Dachaufstockung in Hamburg?',
    answer: 'Für die energetische Ertüchtigung im Rahmen einer Dachaufstockung sind das KfW-Programm 261 (Wohngebäude-Kredit, 5–45 % Tilgungszuschuss) und die BAFA-Einzelmaßnahmen (15–20 % Zuschuss) relevant. Auf Landesebene ergänzt die IFB Hamburg das Programm Wärmeschutz im Gebäudebestand (WSG) mit 43,50 €/m² für die Dachdämmung. Wichtig: Antrag immer vor Beginn des Vorhabens stellen.'
  }
]));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="/leistungen/dachaufstockung/"
  currentPath="/leistungen/dachaufstockung/"
>
  <JsonLdSchema schema={JSON.stringify(generateLocalBusinessSchema())} />
  <JsonLdSchema schema={serviceSchemaStr} />
  <JsonLdSchema schema={JSON.stringify(generateBreadcrumbSchema([
    { name: 'Home', url: 'https://dachgeschossausbauhamburg.de/' },
    { name: 'Leistungen', url: 'https://dachgeschossausbauhamburg.de/leistungen/' },
    { name: 'Dachaufstockung', url: 'https://dachgeschossausbauhamburg.de/leistungen/dachaufstockung/' },
  ]))} />
  <JsonLdSchema schema={faqSchemaStr} />

  <!-- HERO -->
  <section class="bg-primary py-16 lg:py-20">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block text-sm font-medium text-white/60 mb-4">Leistungen</span>
          <h1 class="text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
            Dachaufstockung Hamburg – Mehr Wohnraum durch ein zusätzliches Geschoss
          </h1>
          <p class="text-xl text-white/70 mb-8 leading-relaxed">
            Eine Dachaufstockung in Hamburg schafft ein vollständig neues Vollgeschoss auf bestehenden Gebäuden
            – die wirksamste Methode, in der wachsenden Hansestadt zusätzlichen Wohnraum zu schaffen,
            ohne neue Grundstücksfläche zu verbrauchen. Wir planen, statisch bemessen und bauen Ihre
            Aufstockung – schlüsselfertig und mit Hamburger Genehmigungssicherheit.
          </p>
          <div class="flex flex-wrap gap-4 text-sm text-white/60">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              2.500–4.500 €/m²
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              §61 HBauO 2026
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              8–14 Wochen Bauzeit
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              KfW 261 / BAFA / IFB
            </span>
          </div>
        </div>
        <div>
          <LeadGenForm />
        </div>
      </div>
    </Container>
  </section>

  <!-- WAS IST EINE DACHAUFSTOCKUNG? -->
  <section class="py-16 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto content-area">
        <SectionHeader
          badge="Definition"
          heading="Was ist eine Dachaufstockung?"
          headingLevel="h2"
          align="left"
        />
        <p class="text-text-secondary leading-relaxed">
          Eine Dachaufstockung – in der Fachsprache auch <strong class="text-text-primary">Geschossaufstockung</strong>
          oder <strong class="text-text-primary">Aufstockungsgeschoss</strong> – bezeichnet den vollständigen Neubau eines
          zusätzlichen Vollgeschosses auf einem bestehenden Gebäude. Im Gegensatz zum klassischen
          Dachgeschossausbau, der lediglich die bereits vorhandene Dachhülle zu Wohnraum ausbaut,
          wird bei der Aufstockung das Gebäude in seiner gesamten Höhe verändert: Das alte Dach
          wird abgetragen, ein neuer Geschosskörper aufgesetzt, das neue Dach kommt obendrauf.
        </p>
        <p class="text-text-secondary leading-relaxed">
          In Hamburg trifft die Aufstockung einen Nerv: Die Hansestadt wächst jährlich um rund
          20.000–25.000 Einwohner, freie Bauflächen im inneren Stadtgebiet sind praktisch nicht
          mehr vorhanden. Wer in Eimsbüttel, Altona, Barmbek oder Winterhude wohnt, kann nicht
          seitlich anbauen – aber nach oben. Die Dachaufstockung nutzt die ungenutzte Reserve
          in der Höhe vieler Nachkriegsbauten und schafft auf einen Schlag eine komplette
          Wohnebene zusätzlich.
        </p>
        <p class="text-text-secondary leading-relaxed">
          Technisch, statisch und genehmigungsrechtlich ist die Aufstockung allerdings eine
          deutlich größere Aufgabe als ein DG-Ausbau. Sie erfordert eine Tragwerksplanung,
          Brandschutzkonzepte, neue Erschließung (Treppe, ggf. Aufzug) und immer eine
          Baugenehmigung. Dafür gewinnen Sie in der Regel 60–100 m² zusätzliche Wohnfläche
          und steigern den Wert Ihrer Immobilie nachhaltig.
        </p>
      </div>
    </Container>
  </section>

  <!-- VORTEILE -->
  <section class="py-16">
    <Container>
      <div class="max-w-3xl">
        <SectionHeader
          badge="Vorteile"
          heading="Warum eine Dachaufstockung in Hamburg?"
          subheading="Fünf Gründe, die für ein zusätzliches Geschoss sprechen – gerade in Hamburg."
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
          <div class="bg-surface rounded-xl p-6 border border-border">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
            </div>
            <h3 class="font-bold text-text-primary mb-2">Volle Wohnfläche</h3>
            <p class="text-sm text-text-secondary leading-relaxed">Anders als beim DG-Ausbau gibt es keine Schrägen – jeder Quadratmeter ist voll nutzbar. Auf 80 m² Grundfläche entstehen 80 m² Wohnraum.</p>
          </div>
          <div class="bg-surface rounded-xl p-6 border border-border">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <h3 class="font-bold text-text-primary mb-2">Wertsteigerung 20–30 %</h3>
            <p class="text-sm text-text-secondary leading-relaxed">Eine Aufstockung steigert den Gebäudewert nachweislich um 20–30 %. In Hamburg zahlt sich das aus – die Mieten für neue Dachgeschosswohnungen liegen oft deutlich über dem Bestand.</p>
          </div>
          <div class="bg-surface rounded-xl p-6 border border-border">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-bold text-text-primary mb-2">Kein neuer Boden</h3>
            <p class="text-sm text-text-secondary leading-relaxed">Im dicht bebauten Hamburg ist Bauland knapp und teuer. Die Aufstockung nutzt die vorhandene Bodenfläche – ökologisch wie wirtschaftlich die bessere Lösung.</p>
          </div>
          <div class="bg-surface rounded-xl p-6 border border-border">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-bold text-text-primary mb-2">Förderfähig</h3>
            <p class="text-sm text-text-secondary leading-relaxed">Die energetische Ertüchtigung im Rahmen einer Aufstockung ist über KfW 261 (bis 45 % Tilgungszuschuss), BAFA (15–20 % Zuschuss) und IFB Hamburg (43,50 €/m² WSG) förderfähig.</p>
          </div>
          <div class="bg-surface rounded-xl p-6 border border-border">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            </div>
            <h3 class="font-bold text-text-text-primary mb-2">Hamburg-Bonus</h3>
            <p class="text-sm text-text-secondary leading-relaxed">In Hamburg können Eigentümer neuer Dachgeschosswohnungen unter Umständen von erleichterten Stellplatzregelungen und der Wohnraumförderung der IFB profitieren.</p>
          </div>
          <div class="bg-surface rounded-xl p-6 border border-border">
            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </div>
            <h3 class="font-bold text-text-primary mb-2">Beste Aussicht</h3>
            <p class="text-sm text-text-secondary leading-relaxed">Die oberste Etage bietet die beste Aussicht und die hellsten Wohnungen – besonders über den Dächern Hamburgs mit Blick auf Alster, Elbe oder Stadtpark ein echtes Verkaufsargument.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- AUFSTOCKUNGS-TYPEN -->
  <section class="py-16 bg-bg">
    <Container>
      <div class="max-w-3xl">
        <SectionHeader
          badge="Konstruktionsarten"
          heading="Vier Arten der Dachaufstockung"
          subheading="Welcher Typ zu Ihrem Gebäude passt, hängt von Statik, Dachform, Stadtbild und Budget ab."
        />

        <div class="mt-8 space-y-6">
          <!-- Vollgeschoss in Holzbauweise -->
          <div class="bg-surface rounded-xl border border-border overflow-hidden">
            <div class="p-6">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-xl font-bold text-text-primary mb-1">Vollgeschoss in Holzbauweise</h3>
                  <span class="text-sm text-primary font-semibold">2.500–3.500 €/m²</span>
                </div>
                <span class="inline-flex items-center gap-1 bg-primary/10 text-primary text-xs font-medium px-3 py-1 rounded-full">Hamburger Standard</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed mb-4">
                Die mit Abstand häufigste Aufstockungsvariante in Hamburg: Ein komplett vorgefertigter
                Holzbau-Aufbau in Elementbauweise wird innerhalb weniger Tage auf das Bestandsdach
                aufgesetzt. Das geringe Eigengewicht (ca. 80–120 kg/m²) belastet die Bestandsstatik
                nur minimal, die Bauphase ist kurz (1–2 Tage Aufrichten), und der U-Wert der
                Außenwände ist mit 0,15–0,20 W/(m²K) förderfähig nach GEG.
              </p>
              <div class="flex flex-wrap gap-3 text-xs text-text-secondary">
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Gewicht: 80–120 kg/m²</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Bauzeit Aufrichten: 1–2 Tage</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">U-Wert: 0,15–0,20</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Einsatz: Flachdach &amp; Satteldach</span>
              </div>
            </div>
          </div>

          <!-- Vollgeschoss Massivbau -->
          <div class="bg-surface rounded-xl border border-border overflow-hidden">
            <div class="p-6">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-xl font-bold text-text-primary mb-1">Vollgeschoss in Massivbauweise</h3>
                  <span class="text-sm text-primary font-semibold">3.200–4.500 €/m²</span>
                </div>
                <span class="inline-flex items-center gap-1 bg-primary/10 text-primary text-xs font-medium px-3 py-1 rounded-full">Höchster Schallschutz</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed mb-4">
                Wo Holzbau an seine Grenzen stößt – etwa bei Lärm- oder Brandschutzanforderungen in
                Mehrfamilienhäusern – ist die Massivbau-Aufstockung die richtige Wahl. Kalksandstein,
                Porenbeton oder Betonfertigteile werden vor Ort ergänzt. Das Gewicht ist mit
                350–500 kg/m² deutlich höher, was eine sorgfältige statische Bestandsanalyse voraussetzt.
              </p>
              <div class="flex flex-wrap gap-3 text-xs text-text-secondary">
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Gewicht: 350–500 kg/m²</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Schallschutz: ≥ 56 dB</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Brandschutz: F90 möglich</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Einsatz: MFH &amp; Gewerbe</span>
              </div>
            </div>
          </div>

          <!-- Staffelgeschoss / Penthouse -->
          <div class="bg-surface rounded-xl border border-border overflow-hidden">
            <div class="p-6">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-xl font-bold text-text-primary mb-1">Staffelgeschoss / Penthouse</h3>
                  <span class="text-sm text-primary font-semibold">3.500–4.800 €/m²</span>
                </div>
                <span class="inline-flex items-center gap-1 bg-primary/10 text-primary text-xs font-medium px-3 py-1 rounded-full">Premium-Adresse</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed mb-4">
                Ein Staffelgeschoss setzt das neue Geschoss zurückversetzt (zurückgestaffelt) auf –
                die entstandene Dachterrasse ist in Hamburg besonders begehrt. Penthouses dieser
                Art entstehen zunehmend in HafenCity, an der Alster und in Eppendorf. Hohe
                Lagequalität trifft auf höchste Ausstattungsstandards – und entsprechende Mieten
                oder Verkaufspreise.
              </p>
              <div class="flex flex-wrap gap-3 text-xs text-text-secondary">
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Dachterrasse: inklusive</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Lage: Premium-Viertel</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Miete: 22–30 €/m²</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Stadtbild: prägend</span>
              </div>
            </div>
          </div>

          <!-- Modulare Aufstockung -->
          <div class="bg-surface rounded-xl border border-border overflow-hidden">
            <div class="p-6">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-xl font-bold text-text-primary mb-1">Modulare Aufstockung (Modulbau)</h3>
                  <span class="text-sm text-primary font-semibold">2.800–3.800 €/m²</span>
                </div>
                <span class="inline-flex items-center gap-1 bg-primary/10 text-primary text-xs font-medium px-3 py-1 rounded-full">Schnellste Bauweise</span>
              </div>
              <p class="text-sm text-text-secondary leading-relaxed mb-4">
                Bei der modularen Aufstockung werden komplette Raummodule im Werk vorgefertigt und
                in einem Stück per Kran aufgesetzt. Bauzeit vor Ort: oft nur 2–3 Tage. Ideal für
                Reihen- und Mehrfamilienhäuser, wenn die Bauphase minimal und die Belastung der
                Bewohner gering bleiben soll. Voraussetzung: Kranstellplatz und eine Anfahrt für
                Tieflader.
              </p>
              <div class="flex flex-wrap gap-3 text-xs text-text-secondary">
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Bauzeit vor Ort: 2–3 Tage</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Werkstattfertigung</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Kran erforderlich</span>
                <span class="bg-bg px-3 py-1 rounded-full border border-border">Einsatz: Reihen-/MFH</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- KOSTEN -->
  <section class="py-16">
    <Container>
      <div class="max-w-3xl">
        <SectionHeader
          badge="Kosten Hamburg 2026"
          heading="Was kostet eine Dachaufstockung in Hamburg?"
          subheading="Hamburger Richtwerte für ein zusätzliches Vollgeschoss – schlüsselfertig inkl. Erschließung."
        />

        <div class="mt-8 overflow-x-auto rounded-xl border border-border">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-primary text-white text-left">
                <th class="px-6 py-4 font-semibold">Position</th>
                <th class="px-6 py-4 font-semibold text-right">Von</th>
                <th class="px-6 py-4 font-semibold text-right">Bis</th>
                <th class="px-6 py-4 font-semibold">Bemerkung</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr class="bg-surface">
                <td class="px-6 py-4 font-medium">Holzbau-Aufstockung (Vollgeschoss)</td>
                <td class="px-6 py-4 text-right font-mono">2.500 €/m²</td>
                <td class="px-6 py-4 text-right font-mono">3.500 €/m²</td>
                <td class="px-6 py-4 text-text-secondary">Hamburger Standard, schnelle Bauweise</td>
              </tr>
              <tr class="bg-bg">
                <td class="px-6 py-4 font-medium">Massivbau-Aufstockung</td>
                <td class="px-6 py-4 text-right font-mono">3.200 €/m²</td>
                <td class="px-6 py-4 text-right font-mono">4.500 €/m²</td>
                <td class="px-6 py-4 text-text-secondary">MFH, hoher Schall-/Brandschutz</td>
              </tr>
              <tr class="bg-surface">
                <td class="px-6 py-4 font-medium">Staffelgeschoss / Penthouse</td>
