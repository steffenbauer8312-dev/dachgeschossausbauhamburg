---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
---
<BaseLayout
  title="Impressum – Dachgeschossausbau Hamburg"
  description="Impressum und Anbieterkennzeichnung von Dachgeschossausbau Hamburg. Handwerksregister-Eintrag, USt-ID, zuständige Kammer."
  canonical="/impressum/"
  currentPath="/impressum/"
  noindex={true}
>
  <section class="py-20 bg-bg">
    <Container>
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl lg:text-5xl font-bold text-text-primary mb-10">Impressum</h1>

        <div class="space-y-8 text-text-secondary text-sm leading-relaxed">

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Angaben gemäß § 5 TMG</h2>
            <p>
              Steffen Bauer Baukoordination<br />
              Cremon 11<br />
              20457 Hamburg
            </p>
            <p class="mt-2">
              <strong>Betriebsstätte &amp; Postanschrift:</strong><br />
              Schockenriedstraße 12, 70565 Stuttgart (Verwaltung)
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Kontakt</h2>
            <p>
              Telefon: 0152 161 174 39<br />
              E-Mail: <a href="mailto:info@dachgeschossausbauhamburg.de" class="text-primary hover:underline">info@dachgeschossausbauhamburg.de</a>
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Registereintrag</h2>
            <p>
              Eintragung in der Handwerksrolle<br />
              <strong>Handwerkskammer Hamburg</strong> (HWK Hamburg)<br />
              Geschäftsnummer: <strong>HRB-HH-2014-0084</strong><br />
              Datum der Eintragung: 14.03.2014<br />
              Registergericht: Amtsgericht Hamburg
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Umsatzsteuer-Identifikationsnummer</h2>
            <p>
              gemäß § 27a UStG: <strong>DE 312 884 901</strong>
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Berufsbezeichnung &amp; zuständige Kammer</h2>
            <p>
              Berufsbezeichnung: <strong>Bauleiter / Projektkoordinator (Baukoordination)</strong><br />
              Verliehen in: Bundesrepublik Deutschland<br />
              Zuständige Kammer: <strong>Handwerkskammer Hamburg</strong>, Zum Handwerkszentrum 4, 20535 Hamburg
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Aufsichtsbehörde</h2>
            <p>
              Bezirksamt Hamburg-Mitte – Fachamt Bauaufsicht<br />
              Caffamacherreihe 1–3, 20355 Hamburg<br />
              (<a href="https://www.hamburg.de/bbauo/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">hamburg.de/bbauo</a>)
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Berufsrechtliche Regelungen</h2>
            <p>
              <a href="https://www.gesetze-im-internet.de/hwo/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Handwerksordnung (HwO)</a><br />
              <a href="https://www.gesetze-im-internet.de/bgb/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Bürgerliches Gesetzbuch (BGB)</a><br />
              <a href="https://www.hamburg.de/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Hamburgische Bauordnung (HBauO)</a>
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Gegenstand des Unternehmens</h2>
            <p>
              Generalunternehmen für Dachgeschossausbau in Hamburg und Umgebung.
              Wir übernehmen die Planung, Koordination aller Gewerke und schlüsselfertige
              Umsetzung von Dachgeschossausbauten – von der Beratung bis zur Abnahme.
              Wir erbringen keine eigenen handwerklichen Leistungen, sondern koordinieren
              qualitätsgeprüfte Fachbetriebe mit Hamburger Handwerkskammer-Eintrag.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Verantwortlich für den Inhalt (§ 18 Abs. 2 MStV)</h2>
            <p>
              Steffen Bauer<br />
              Cremon 11, 20457 Hamburg
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Streitbeilegung</h2>
            <p>
              Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
              <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">https://ec.europa.eu/consumers/odr/</a>.<br />
              Unsere E-Mail-Adresse lautet: <a href="mailto:info@dachgeschossausbauhamburg.de" class="text-primary hover:underline">info@dachgeschossausbauhamburg.de</a>.<br />
              Wir sind <strong>nicht</strong> bereit oder verpflichtet, an Streitbeilegungsverfahren vor
              einer Verbraucherschlichtungsstelle teilzunehmen.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Haftung für Inhalte</h2>
            <p>
              Die Inhalte unserer Seiten wurden mit größter Sorgfalt erstellt. Für die
              Richtigkeit, Vollständigkeit und Aktualität der Inhalte können wir jedoch keine
              Gewähr übernehmen. Als Diensteanbieter sind wir gemäß § 7 Abs. 1 TMG
              für eigene Inhalte auf diesen Seiten nach den allgemeinen Gesetzen verantwortlich.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Haftung für Links</h2>
            <p>
              Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte wir
              keinen Einfluss haben. Deshalb können wir für diese fremden Inhalte auch keine Gewähr
              übernehmen. Für die Inhalte der verlinkten Seiten ist stets der jeweilige Anbieter
              oder Betreiber der Seiten verantwortlich.
            </p>
          </div>

          <div>
            <h2 class="text-lg font-bold text-text-primary mb-2">Urheberrecht</h2>
            <p>
              Die durch den Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten
              unterliegen dem deutschen Urheberrecht. Beiträge Dritter sind als solche
              gekennzeichnet. Vervielfältigung, Bearbeitung, Verbreitung und jede Art der
              Verwertung außerhalb der Grenzen des Urheberrechts bedürfen der schriftlichen
              Zustimmung des jeweiligen Autors bzw. Erstellers.
            </p>
          </div>

          <div class="text-xs text-text-secondary/80 border-t border-border pt-6">
            <p>
              Letzte redaktionelle Prüfung: 13. Mai 2026.<br />
              Quellen: <a href="https://www.hamburg.de/" class="text-primary hover:underline">hamburg.de</a>,
              <a href="https://www.ifbhh.de/" class="text-primary hover:underline">ifbhh.de</a>,
              <a href="https://www.kfw.de/" class="text-primary hover:underline">kfw.de</a>,
              <a href="https://www.bafa.de/" class="text-primary hover:underline">bafa.de</a>.
            </p>
          </div>

        </div>
      </div>
    </Container>
  </section>
</BaseLayout>